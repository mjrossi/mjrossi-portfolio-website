{
  "name": "mjrossi-site",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/make-post-og.mjs && node scripts/gen-headers.mjs",
    "smoke": "node scripts/smoke.mjs",
    "test": "node --test 'src/**/*.test.js'",
    "preview": "npm run build && wrangler dev --port 8788",
    "preview-link": "node scripts/preview-link.mjs",
    "preview-roster": "node scripts/preview-roster.mjs",
    "preview-extend": "node scripts/preview-extend.mjs",
    "galley": "node scripts/galley-pull.mjs",
    "galley-close": "node scripts/galley-close.mjs",
    "galley-reopen": "node scripts/galley-reopen.mjs",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14",
    "@astrojs/markdown-remark": "7.2.4",
    "@astrojs/mdx": "^7.0.7",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^7.2.4",
    "js-yaml": "4.3.1",
    "sharp": "0.35.3"
  },
  "devDependencies": {
    "typescript": "^6.0.3",
    "wrangler": "4.125.0"
  }
}
