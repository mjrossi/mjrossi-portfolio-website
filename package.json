{
  "name": "mjrossi-site",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/make-post-og.mjs && node scripts/gen-headers.mjs",
    "smoke": "node scripts/smoke.mjs",
    "test": "node --test 'src/**/*.test.js'",
    "preview": "npm run build && wrangler dev --port 8788",
    "preview-link": "node scripts/preview-link.mjs",
    "preview-roster": "node scripts/preview-roster.mjs",
    "preview-extend": "node scripts/preview-extend.mjs",
    "galley": "node scripts/galley-pull.mjs",
    "galley-close": "node scripts/galley-close.mjs",
    "galley-reopen": "node scripts/galley-reopen.mjs",
    "post-rename": "node scripts/post-rename.mjs",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.6",
    "@astrojs/markdown-remark": "7.3.6",
    "@astrojs/mdx": "^8.1.3",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/internal-helpers": "0.13.1",
    "astro": "^7.4.7",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "jsqr": "1.4.0",
    "qrcode": "1.5.4",
    "typescript": "^6.0.3",
    "wrangler": "4.158.0"
  }
}
