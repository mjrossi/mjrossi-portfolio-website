---
import PostTopics from './PostTopics.astro';
import { dateFormatter, isoDate, postReadingTime, type Post } from '../lib/blog.ts';
import { isPublished } from '../lib/schedule.js';

interface Props {
  post: Post;
}

const { post } = Astro.props;

// Keyed off isPublished rather than the preview flag, so the badge is correct
// by construction: it can only ever appear on a post that isn't live yet.
const scheduled = !isPublished(post.data.pubDate);
---
<article class="post-entry">
  <div class="post-entry-meta">
    {scheduled && (
      <span class="post-scheduled">Scheduled</span>
    )}
    <time datetime={isoDate(post.data.pubDate)}>
      {dateFormatter.format(post.data.pubDate)}
    </time>
    <span class="meta-sep" aria-hidden="true">·</span>
    <span>{postReadingTime(post)}</span>
    <PostTopics tags={post.data.tags} />
  </div>
  <h2 class="post-entry-title">
    <a href={`/blog/${post.id}/`}>{post.data.title}</a>
  </h2>
  {/*
    The chip row is deliberately gone from index entries (finding 2.1): five or
    six saturated chips per entry were the first thing the eye landed on, ahead
    of the titles. Up to two topics go in the meta line above; the full set
    lives on the post itself.
  */}
  <p class="post-entry-description">{post.data.description}</p>
</article>
