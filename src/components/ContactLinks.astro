---
// Inline SVG so the icons inherit currentColor from .contact-links a and
// stay CSP-clean (same-origin, no external <img src>). Each anchor carries
// its own aria-label; the wrapper nav's aria-label names the cluster. The
// profile URLs live in src/lib/profiles.js, shared with the .vcf.
// Mastodon's rel="me" is what verifies mjrossi.com on that profile; see
// profiles.js. Both renderings carry it, so it is in the HTML at every width.
import { GITHUB, LINKEDIN, BLUESKY, MASTODON } from '../lib/profiles.js';
---
<nav class="contact-links" aria-label="Contact">
  <a href={GITHUB.url} target="_blank" rel="noopener noreferrer" aria-label={GITHUB.label}>
    <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
      <path fill="currentColor" d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.1.79-.25.79-.55v-2.02c-3.2.69-3.87-1.36-3.87-1.36-.52-1.33-1.28-1.68-1.28-1.68-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.76 2.7 1.25 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.68 0-1.26.45-2.28 1.19-3.08-.12-.29-.52-1.47.11-3.06 0 0 .97-.31 3.18 1.17a11 11 0 0 1 5.79 0c2.21-1.48 3.18-1.17 3.18-1.17.63 1.59.23 2.77.11 3.06.74.8 1.19 1.82 1.19 3.08 0 4.41-2.69 5.39-5.26 5.67.41.36.78 1.06.78 2.13v3.16c0 .3.21.66.8.55C20.22 21.38 23.5 17.08 23.5 12 23.5 5.65 18.35.5 12 .5Z"/>
    </svg>
  </a>
  <a href={LINKEDIN.url} target="_blank" rel="noopener noreferrer" aria-label={LINKEDIN.label}>
    <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
      <path fill="currentColor" d="M20.45 20.45h-3.55v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12ZM7.12 20.45H3.56V9h3.56v11.45ZM22.22 0H1.77C.79 0 0 .77 0 1.72v20.56C0 23.23.79 24 1.77 24h20.45C23.2 24 24 23.23 24 22.28V1.72C24 .77 23.2 0 22.22 0Z"/>
    </svg>
  </a>
  <a href="/api/contact" aria-label="Email">
    <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
      <path fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" d="M3.25 5.75h17.5a1 1 0 0 1 1 1v10.5a1 1 0 0 1-1 1H3.25a1 1 0 0 1-1-1V6.75a1 1 0 0 1 1-1Z"/>
      <path fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" d="m2.75 7 9.25 6.5L21.25 7"/>
    </svg>
  </a>
  <a href={BLUESKY.url} target="_blank" rel="noopener noreferrer" aria-label={BLUESKY.label}>
    <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
      <path fill="currentColor" d="M5.35 3.65c2.86 2.15 5.93 6.5 7.06 8.84 1.13-2.34 4.2-6.69 7.06-8.84 2.06-1.55 5.4-2.75 5.4 1.05 0 .76-.44 6.38-.7 7.3-.87 3.17-4.1 3.98-6.97 3.49 5.02.85 6.3 3.68 3.54 6.5-5.25 5.36-7.55-1.35-8.14-3.07-.11-.32-.16-.47-.16-.34 0-.13-.05.02-.16.34-.59 1.72-2.89 8.43-8.14 3.07-2.76-2.82-1.48-5.65 3.54-6.5-2.87.49-6.1-.32-6.97-3.49C.5 11.08.06 5.46.06 4.7c0-3.8 3.33-2.6 5.4-1.05Z"/>
    </svg>
  </a>
  <a href={MASTODON.url} target="_blank" rel="me noopener noreferrer" aria-label={MASTODON.label}>
    <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
      <path fill="currentColor" d="M23.27 5.31C22.92 2.73 20.65.7 17.96.31 17.51.24 15.79 0 11.81 0h-.03C7.8 0 6.95.24 6.5.31 3.88.69 1.5 2.52.92 5.13.64 6.41.61 7.84.66 9.14c.07 1.87.09 3.75.26 5.61.12 1.24.33 2.47.62 3.68.55 2.24 2.78 4.1 4.96 4.86 2.34.79 4.85.92 7.26.38.26-.06.53-.13.79-.21.58-.18 1.27-.39 1.77-.75a.06.06 0 0 0 .02-.04v-1.81a.05.05 0 0 0-.07-.05 20.3 20.3 0 0 1-4.71.55c-2.73 0-3.46-1.28-3.67-1.82a5.6 5.6 0 0 1-.32-1.43.05.05 0 0 1 .07-.05c1.52.36 3.07.55 4.63.55.38 0 .75 0 1.13-.01 1.57-.04 3.22-.12 4.77-.42l.11-.02c2.44-.46 4.75-1.92 4.99-5.6.01-.15.03-1.52.03-1.67 0-.51.17-3.63-.02-5.55Zm-3.75 9.2h-2.56V8.29c0-1.31-.55-1.98-1.67-1.98-1.23 0-1.85.79-1.85 2.35v3.4h-2.55V8.66c0-1.56-.61-2.35-1.84-2.35-1.11 0-1.67.67-1.67 1.98v6.22H4.82V8.1c0-1.31.34-2.35 1.01-3.12.7-.77 1.61-1.16 2.74-1.16 1.31 0 2.3.5 2.96 1.5l.64 1.06.64-1.06c.66-1 1.65-1.5 2.96-1.5 1.13 0 2.04.4 2.74 1.16.67.77 1.01 1.81 1.01 3.12v6.41Z"/>
    </svg>
  </a>
</nav>
