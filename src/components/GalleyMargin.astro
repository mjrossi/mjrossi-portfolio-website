---
// Galley review chrome. Rendered ONLY for a signed link that named a reviewer
// (gated in BlogPost.astro), so only on no-store + noindex responses.
//
// The <style> is `is:inline`, and both reasons matter:
//   - Astro hoists a processed <style> into the ROUTE's stylesheet from the
//     module graph, not the render condition, so a plain one shipped ~4.9KB of
//     galley CSS on every published post.
//   - Scoped selectors carry a build-time attribute that the elements galley.js
//     creates at runtime never get, so they matched nothing.
// Smoke asserts no `galley-` rule reaches the CSS bundles.

interface Props {
  slug: string;
  reviewer: string;
  /** The page's revision, echoed on save; null leaves the client unable to write. */
  revision: string | null;
}

const { slug, reviewer, revision } = Astro.props;
---

<div id="galley" data-slug={slug} data-reviewer={reviewer} data-revision={revision}></div>

{/* Static asset, like newsletter.js, so it loads externally under `script-src 'self'`. */}
<script type="module" src="/scripts/galley.js" is:inline></script>

<style is:inline>
  /* Echoes the masthead band, so the review session reads as part of the paper. */
  .galley-bar {
    position: fixed;
    inset-inline: 0;
    bottom: 0;
    z-index: 40;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.6rem var(--pad);
    background: var(--accent-band, var(--bg2));
    border-top: 1px solid var(--accent-band-border, var(--border));
    font-family: var(--font-ui);
    font-size: 0.8rem;
    color: var(--text);
  }

  .galley-bar-label {
    font-variant-caps: all-small-caps;
    letter-spacing: 0.06em;
  }

  .galley-sep {
    color: var(--muted);
  }

  .galley-bar-toggle {
    font: inherit;
    font-variant-caps: all-small-caps;
    letter-spacing: 0.06em;
    color: var(--accent);
    background: none;
    border: 1px solid var(--accent-rule, var(--border));
    border-radius: 2px;
    padding: 0.2rem 0.6rem;
    cursor: pointer;
  }

  .galley-bar-toggle:hover {
    color: var(--accent-hover);
  }

  /* The draft moved under this page: in the accent, because every marker is withheld. */
  .galley-bar-stale {
    margin-left: auto;
    margin-right: 0.8rem;
    color: var(--accent);
    font-style: italic;
  }

  /* Capped, so a long round scrolls inside the panel. */
  .galley-panel {
    position: fixed;
    right: var(--pad);
    bottom: 3rem;
    z-index: 40;
    width: min(24rem, calc(100vw - 2 * var(--pad)));
    max-height: 60vh;
    overflow-y: auto;
    padding: 1rem 1.1rem;
    background: var(--bg);
    border: 1px solid var(--border);
    box-shadow: 0 6px 24px rgb(0 0 0 / 12%);
  }

  .galley-panel-title {
    margin: 0 0 0.6rem;
    font-family: var(--font-serif);
    font-size: 1rem;
    font-variant-caps: all-small-caps;
    letter-spacing: 0.06em;
  }

  .galley-empty {
    margin: 0;
    color: var(--muted);
    font-family: var(--font-ui);
    font-size: 0.8rem;
  }

  .galley-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .galley-note {
    padding: 0.7rem 0;
    border-top: 1px solid var(--border);
  }

  .galley-note:first-child {
    border-top: 0;
  }

  /* One rule for every small-caps label in the margin, so they can't drift apart. */
  .galley-note-meta,
  .galley-addressed-summary,
  .galley-note-sublabel,
  .galley-composer-sublabel {
    font-family: var(--font-ui);
    font-size: 0.72rem;
    color: var(--muted);
    font-variant-caps: all-small-caps;
    letter-spacing: 0.06em;
  }

  .galley-note-meta {
    margin: 0 0 0.3rem;
  }

  .galley-note-reviewer {
    color: var(--accent);
  }

  /* In place of a stale note's line number, which would name the wrong line. */
  .galley-note-stale {
    font-style: italic;
  }

  /* Closed rounds: collapsed and dimmed, visible so points aren't re-filed. */
  .galley-addressed {
    margin-top: 0.8rem;
    border-top: 1px solid var(--border);
    padding-top: 0.6rem;
  }

  .galley-addressed-summary {
    cursor: pointer;
  }

  .galley-list-addressed {
    margin-top: 0.4rem;
  }

  .galley-note-closed {
    opacity: 0.62;
  }

  .galley-note-quote,
  .galley-composer-quote {
    margin: 0 0 0.4rem;
    padding-left: 0.6rem;
    border-left: 2px solid var(--accent-rule, var(--border));
    color: var(--muted);
    font-size: 0.85rem;
    font-style: italic;
  }

  .galley-note-body {
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.5;
  }

  /* Preformatted, so the author reads back exactly what the editor typed. */
  .galley-note-sublabel,
  .galley-composer-sublabel {
    margin: 0.6rem 0 0.25rem;
  }

  .galley-note-suggestion {
    margin: 0;
    padding: 0.5rem 0.6rem;
    background: var(--bg2);
    border-left: 2px solid var(--accent);
    font-family: var(--font);
    font-size: 0.85rem;
    line-height: 1.5;
    white-space: pre-wrap;
    overflow-wrap: break-word;
  }

  /* Positioned against the selection by galley.js. */
  .galley-add {
    position: absolute;
    z-index: 50;
    font-family: var(--font-ui);
    font-size: 0.75rem;
    font-variant-caps: all-small-caps;
    letter-spacing: 0.06em;
    padding: 0.3rem 0.7rem;
    color: var(--bg);
    background: var(--accent);
    border: 0;
    border-radius: 2px;
    cursor: pointer;
  }

  .galley-add:hover {
    background: var(--accent-hover);
  }

  /* LIFTED CLEAR OF THE ON-SCREEN KEYBOARD. The keyboard no longer shrinks the
     layout viewport (Chrome Android 108, Firefox Android 132, like Safari), so a
     plain `bottom: 4rem` put the textareas under it and the reviewer typed
     blind. galley.js sets --galley-keyboard: 0px on desktop. */
  .galley-composer {
    position: fixed;
    left: 50%;
    bottom: calc(4rem + var(--galley-keyboard, 0px));
    /* Scroll inside, so `Leave note` at the foot stays on screen. */
    max-height: calc(100svh - 5rem - var(--galley-keyboard, 0px));
    overflow-y: auto;
    transform: translateX(-50%);
    z-index: 50;
    width: min(30rem, calc(100vw - 2 * var(--pad)));
    padding: 1rem 1.1rem;
    background: var(--bg);
    border: 1px solid var(--border);
    box-shadow: 0 6px 24px rgb(0 0 0 / 15%);
  }

  .galley-composer-input {
    width: 100%;
    font: inherit;
    font-size: 0.9rem;
    padding: 0.5rem;
    color: var(--text);
    background: var(--bg);
    border: 1px solid var(--border);
    resize: vertical;
  }

  .galley-composer-input:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 1px;
  }

  .galley-composer-actions {
    display: flex;
    justify-content: flex-end;
    gap: 0.5rem;
    margin-top: 0.6rem;
  }

  .galley-composer-submit,
  .galley-composer-cancel {
    font-family: var(--font-ui);
    font-size: 0.78rem;
    font-variant-caps: all-small-caps;
    letter-spacing: 0.06em;
    padding: 0.35rem 0.8rem;
    border-radius: 2px;
    cursor: pointer;
  }

  .galley-composer-submit {
    color: var(--bg);
    background: var(--accent);
    border: 1px solid var(--accent);
  }

  .galley-composer-submit:hover {
    background: var(--accent-hover);
  }

  .galley-composer-submit:disabled {
    opacity: 0.6;
    cursor: default;
  }

  .galley-composer-cancel {
    color: var(--muted);
    background: none;
    border: 1px solid var(--border);
  }

  .galley-composer-msg {
    margin: 0.5rem 0 0;
    font-family: var(--font-ui);
    font-size: 0.78rem;
    color: var(--muted);
    min-height: 1em;
  }

  .galley-composer-msg.is-error {
    color: var(--danger);
  }

  /* The quoted words, painted on a Range by the Custom Highlight API: no DOM
     mutation, so the anchors stay intact. ::highlight() takes colour only. */
  ::highlight(galley-note) {
    background-color: var(--accent-band-border, #e6c9a8);
    color: var(--text);
  }

  /* A block holding notes that couldn't be placed more precisely.

     A FLAT WASH ACROSS THE WHOLE ELEMENT, deliberately. The old highlighter
     gradient resolved against the PARAGRAPH box on a block and banded its last
     lines — pointing at prose no note was about. Anything with an edge inside
     the block re-creates that. */
  .post-body .galley-marked {
    background-color: var(--accent-band, #f3e5d5);
    border-radius: 2px;
    /* Room past the text without reflowing it, as padding would. */
    box-shadow: 0 0 0 0.2rem var(--accent-band, #f3e5d5);
  }

  /* Trails the text like a footnote mark, in flow: absolutely positioned it
     floated mid-paragraph, and li/blockquote have no margin to hang it off. */
  .post-body .galley-marked::after {
    content: attr(data-galley-count);
    margin-left: 0.3em;
    vertical-align: super;
    font-family: var(--font-ui);
    font-size: 0.6rem;
    color: var(--accent);
  }

  @media (max-width: 40rem) {
    .galley-panel {
      right: 0;
      left: 0;
      width: auto;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .galley-composer,
    .galley-panel {
      animation: galley-rise 120ms ease-out;
    }
  }

  @keyframes galley-rise {
    from {
      opacity: 0;
      transform: translateY(4px);
    }
  }

  /* Own keyframes, or the shared animation drops the transform's centring. */
  @media (prefers-reduced-motion: no-preference) {
    .galley-composer {
      animation-name: galley-rise-centred;
    }
  }

  @keyframes galley-rise-centred {
    from {
      opacity: 0;
      transform: translateX(-50%) translateY(4px);
    }
    to {
      transform: translateX(-50%);
    }
  }
</style>
