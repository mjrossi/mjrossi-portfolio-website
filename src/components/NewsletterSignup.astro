---
// Newsletter signup card. Rendered ONLY on /blog — this is the single carve-out
// from the site's no-client-JS rule. Do not lift into Base.astro or any
// shared chrome; the smoke test asserts the form is absent on / and other
// routes precisely to guard against accidental lifts.
//
// `import.meta.env.PUBLIC_TURNSTILE_SITE_KEY` is inlined at build time. When
// the value isn't set in the build environment Vite inlines `undefined`,
// which surfaces here at REQUEST time (the route is on-demand). Rather than
// throw — which would 500 the whole /blog page for visitors — we omit the
// form and log the misconfiguration to Worker observability so it's visible
// to the operator without breaking the page.
const siteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
if (!siteKey) {
  console.error(
    'NewsletterSignup: PUBLIC_TURNSTILE_SITE_KEY is not set; omitting form. ' +
    'Local dev: add to mise.local.toml [env]. ' +
    'Production: Cloudflare → Workers → this project → Settings → Build configuration → Variables and Secrets.',
  );
}
---

{siteKey && (
  <Fragment>
    <aside class="newsletter" aria-labelledby="newsletter-heading">
      <div class="newsletter-rule" aria-hidden="true"></div>

      <div class="newsletter-card">
        <h2 id="newsletter-heading">Subscribe by email</h2>
        <p class="newsletter-blurb">
          Letters from this page in your inbox. No tracking. Unsubscribe anytime
          via the link in any email. Powered by <a href="https://buttondown.com" rel="noopener">Buttondown</a>.
        </p>

        <form id="newsletter-form" novalidate>
          <label for="newsletter-email">Email</label>
          <input
            id="newsletter-email"
            name="email"
            type="email"
            required
            autocomplete="email"
            inputmode="email"
            placeholder="you@example.com"
          />

          <input
            class="newsletter-hp"
            type="text"
            name="company"
            tabindex="-1"
            autocomplete="off"
            aria-hidden="true"
          />

          <div class="cf-turnstile" data-sitekey={siteKey} data-theme="light" data-size="flexible"></div>

          <button type="submit">Subscribe</button>

          <p class="newsletter-msg" role="status" aria-live="polite"></p>

          <p class="newsletter-fineprint">
            Anti-spam by Cloudflare Turnstile · delivery by Buttondown ·
            see <a href="/privacy">privacy</a>.
          </p>
        </form>
      </div>

      <div class="newsletter-rule" aria-hidden="true"></div>
    </aside>

    <!--
      Submit handler lives as a static asset at /scripts/newsletter.js (under
      public/scripts/). Shipped that way deliberately:
       1. it's the only client JS on the site, so the bundle-vs-inline question
          doesn't compound;
       2. as a static asset it's served by the Cloudflare ASSETS binding and
          loads under our strict `script-src 'self' …` CSP without needing
          'unsafe-inline', per-page hashes, or nonces;
       3. Astro's bundler may inline <script> blocks on on-demand routes
          (especially under the Cloudflare adapter) — shipping the file under
          public/ avoids that variability.
    -->
    <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
    <script type="module" src="/scripts/newsletter.js" is:inline></script>
  </Fragment>
)}

<style>
  .newsletter {
    margin: 3.5rem 0 1.5rem;
  }

  .newsletter-rule {
    height: 1px;
    background: var(--accent-rule);
    position: relative;
  }

  .newsletter-rule::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: 4px;
    height: 1px;
    background: var(--accent-band-border);
  }

  .newsletter-card {
    background: var(--accent-band);
    border-left: 1px solid var(--accent-band-border);
    border-right: 1px solid var(--accent-band-border);
    padding: clamp(1.5rem, 4vw, 2rem) clamp(1.25rem, 4vw, 2rem);
    margin: 8px 0;
  }

  .newsletter-card h2 {
    font-family: var(--font-serif);
    font-size: 1.35rem;
    font-weight: 600;
    margin: 0 0 0.5rem;
    color: var(--text);
  }

  .newsletter-blurb {
    font-family: var(--font);
    font-size: 0.95rem;
    color: var(--muted);
    margin: 0 0 1.25rem;
    max-width: 38rem;
  }

  .newsletter-blurb a {
    text-decoration-color: var(--accent-rule);
    text-underline-offset: 2px;
  }

  .newsletter-blurb a:hover {
    text-decoration-color: var(--accent);
  }

  #newsletter-form {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    max-width: 28rem;
  }

  #newsletter-form label {
    font-family: var(--font-ui);
    font-variant-caps: all-small-caps;
    letter-spacing: 0.06em;
    font-size: 0.85rem;
    color: var(--muted);
    margin-bottom: -0.4rem;
  }

  #newsletter-form input[type='email'] {
    width: 100%;
    padding: 0.65rem 0.75rem;
    background: var(--bg);
    color: var(--text);
    border: 1px solid var(--border);
    border-radius: 2px;
    font: inherit;
    font-size: 1rem;
  }

  #newsletter-form input[type='email']:focus-visible {
    outline-offset: 2px;
    border-color: var(--accent);
  }

  .newsletter-hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    opacity: 0;
    pointer-events: none;
  }

  /* Turnstile widget; :global because the third-party script may rewrite
     the wrapper attributes — keeping the rule outside Astro's scoping
     guarantees the margin sticks regardless. */
  :global(.cf-turnstile) {
    margin: 0.25rem 0;
  }

  #newsletter-form button[type='submit'] {
    background: var(--accent);
    color: #fff;
    border: 1px solid var(--accent);
    border-radius: 2px;
    padding: 0.6rem 1.5rem;
    font-family: var(--font-ui);
    font-variant-caps: all-small-caps;
    letter-spacing: 0.05em;
    font-weight: 600;
    font-size: 1rem;
    cursor: pointer;
    align-self: flex-start;
    transition: background 0.15s ease, border-color 0.15s ease;
  }

  #newsletter-form button[type='submit']:hover {
    background: var(--accent-hover);
    border-color: var(--accent-hover);
  }

  #newsletter-form button[type='submit']:disabled {
    opacity: 0.6;
    cursor: progress;
  }

  .newsletter-msg {
    min-height: 1.4em;
    font-family: var(--font-ui);
    font-size: 0.9rem;
    color: var(--muted);
    margin: 0;
  }

  .newsletter-msg.is-error {
    color: var(--accent-tagline);
  }

  /* .newsletter-success is created at runtime by public/scripts/newsletter.js
     (via document.createElement) and replaces the form on success — it has no
     Astro scoping attribute, so :global is required for the rule to match. */
  :global(.newsletter-success) {
    font-family: var(--font);
    font-style: italic;
    font-size: 1.05rem;
    color: var(--text);
    margin: 0;
  }

  .newsletter-fineprint {
    font-family: var(--font-ui);
    font-size: 0.78rem;
    color: var(--muted);
    margin: 0.5rem 0 0;
    max-width: 32rem;
  }

  .newsletter-fineprint a {
    color: var(--muted);
    text-decoration-color: var(--border);
    text-underline-offset: 2px;
  }

  .newsletter-fineprint a:hover {
    color: var(--accent);
    text-decoration-color: var(--accent);
  }
</style>
