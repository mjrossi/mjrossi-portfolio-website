---
// Previous / next by date, below the tag footer and subscribe card.
//
// A missing neighbour renders NOTHING. The old muted "Newest post" placeholder
// read as the title of the next post, and as a dead link. One child fills the
// grid row (`grid-auto-flow: column`), so there is no half-empty cell. With no
// neighbours at all (the fixture, a one-post archive) there is no nav.
import type { Post } from '../lib/blog.ts';

interface Props {
  previous: Post | null;
  next: Post | null;
}

const { previous, next } = Astro.props;
---

{(previous || next) && (
  <nav class="post-nav" aria-label="More posts">
    {previous && (
      <a class="prev" href={`/blog/${previous.id}/`} rel="prev">
        <div class="k">← Previous</div>
        <div class="t">{previous.data.title}</div>
      </a>
    )}

    {next && (
      <a class="next" href={`/blog/${next.id}/`} rel="next">
        <div class="k">Next →</div>
        <div class="t">{next.data.title}</div>
      </a>
    )}
  </nav>
)}
