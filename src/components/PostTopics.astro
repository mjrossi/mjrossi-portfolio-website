---
// The post's topics in the meta line: UP TO TWO, in frontmatter order. One
// was too thin (the Netherlands post is cycling and infrastructure); the old
// row of six chips was too loud. Order is editorial and makes a series read as
// one: every Atlas post leads with `urbanist-atlas`.
//
// Each topic travels with its separator as ONE flex item, so a wrap never
// strands a "·".
import { tagLabel } from '../lib/tags.js';

interface Props {
  tags: string[];
}

/** Smoke pins this, so raising it is a decision. */
const TOPIC_LIMIT = 2;

const topics = Astro.props.tags.slice(0, TOPIC_LIMIT);
---

{/* For the phone layout, where topics become their own column; `display:
    contents` above that, so the items stay flex items of the meta line. */}
<span class="post-topics">
  {topics.map((tag) => (
    <span class="post-topic-item">
      <span class="meta-sep" aria-hidden="true">·</span>
      <a href={`/blog/tag/${tag}/`} class="post-topic">{tagLabel(tag)}</a>
    </span>
  ))}
</span>
