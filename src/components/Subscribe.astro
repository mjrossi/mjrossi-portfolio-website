---
// The newsletter signup, one form in two variants:
//
//   variant="line" — a one-line band under the blog index header: the ask
//     before the reader has had anything, so it stays quiet.
//   variant="card" — a tonal card at the end of every PUBLISHED post, in
//     --bg2 so it doesn't outshout the next-post link below.
//
// JS CARVE-OUT: ships the Turnstile loader and /scripts/newsletter.js on /blog
// and published posts only — never a non-blog route, never a draft. Do not lift
// it into Base.astro or shared chrome; smoke asserts its absence on `/`.
//
// A missing PUBLIC_TURNSTILE_SITE_KEY is inlined as `undefined` and surfaces at
// request time, so the form is omitted and logged rather than 500ing the page.
interface Props {
  variant?: 'line' | 'card';
}

const { variant = 'card' } = Astro.props;

const siteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
if (!siteKey) {
  console.error(
    'Subscribe: PUBLIC_TURNSTILE_SITE_KEY is not set; omitting form. ' +
    'Local dev: add to mise.local.toml [env]. ' +
    'Production: Cloudflare → Workers → this project → Settings → Build configuration → Variables and Secrets.',
  );
}

// The band has no room for the widget, so it runs interaction-only (drawn only
// if a challenge is needed); the card shows it. Anti-spam is the same either way.
const turnstileAppearance = variant === 'line' ? 'interaction-only' : 'always';
---

{siteKey && (
  <Fragment>
    {variant === 'line' ? (
      <aside class="subscribe-line" aria-labelledby="subscribe-msg">
        <p class="msg" id="subscribe-msg">New issues in your inbox — no tracking.</p>

        <form id="newsletter-form" novalidate>
          <label class="subscribe-sr" for="newsletter-email">Email address</label>
          <input
            id="newsletter-email"
            name="email"
            type="email"
            required
            autocomplete="email"
            inputmode="email"
            placeholder="you@example.com"
          />

          <input
            class="newsletter-hp"
            type="text"
            name="company"
            tabindex="-1"
            autocomplete="off"
            aria-hidden="true"
          />

          <button type="submit">Subscribe</button>
        </form>

        <div
          class="cf-turnstile"
          data-sitekey={siteKey}
          data-theme="auto"
          data-size="flexible"
          data-appearance={turnstileAppearance}
        ></div>

        <p class="newsletter-msg" role="status" aria-live="polite"></p>
      </aside>
    ) : (
      <aside class="subscribe-card" aria-labelledby="subscribe-heading">
        <p class="t" id="subscribe-heading">Keep reading the Lexicon</p>
        <p class="d">
          New issues by email — no tracking, one-click unsubscribe.
          Or follow by <a href="/blog/rss.xml">RSS</a>.
        </p>

        <form id="newsletter-form" novalidate>
          <label class="subscribe-sr" for="newsletter-email">Email address</label>
          <input
            id="newsletter-email"
            name="email"
            type="email"
            required
            autocomplete="email"
            inputmode="email"
            placeholder="you@example.com"
          />

          <input
            class="newsletter-hp"
            type="text"
            name="company"
            tabindex="-1"
            autocomplete="off"
            aria-hidden="true"
          />

          <button type="submit">Subscribe</button>
        </form>

        <div
          class="cf-turnstile"
          data-sitekey={siteKey}
          data-theme="auto"
          data-size="flexible"
          data-appearance={turnstileAppearance}
        ></div>

        <p class="newsletter-msg" role="status" aria-live="polite"></p>

        {/* The fine print minus "· or use RSS": the description above links it. */}
        <p class="subscribe-fine">
          Delivered by <a href="https://buttondown.com" rel="noopener">Buttondown</a> ·
          <a href="/privacy">privacy</a>
        </p>
      </aside>
    )}

    <!-- A static asset, so it loads externally under `script-src 'self'` with no inlining. -->
    <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
    <script type="module" src="/scripts/newsletter.js" is:inline></script>
  </Fragment>
)}

<style>
  /* Both variants share the field and button; only the frame differs. */

  .subscribe-sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .newsletter-hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    opacity: 0;
    pointer-events: none;
  }

  .subscribe-line input,
  .subscribe-card input[type='email'] {
    flex: 1;
    min-width: 0;
    /* --muted, not --border: the outline is the field's only boundary and must
       clear 3:1 (--border is ~1.3:1). */
    border: 1px solid var(--muted);
    border-radius: 0;
    padding: 0.38rem 0.55rem;
    font-family: var(--font-ui);
    font-size: 0.75rem;
    background: var(--bg);
    color: var(--text);
  }

  .subscribe-line input::placeholder,
  .subscribe-card input::placeholder {
    color: var(--muted);
  }

  .subscribe-line button,
  .subscribe-card button {
    background: var(--text);
    color: var(--bg);
    border: 0;
    border-radius: 2px;
    padding: 0.38rem 0.8rem;
    font-family: var(--font-ui);
    font-size: 0.75rem;
    font-weight: 500;
    cursor: pointer;
    white-space: nowrap;
    transition: background 0.15s ease;
  }

  .subscribe-line button:hover,
  .subscribe-card button:hover {
    background: var(--accent-hover);
  }

  .subscribe-line button:disabled,
  .subscribe-card button:disabled {
    opacity: 0.6;
    cursor: progress;
  }

  /* A — the band under the blog index header. */
  .subscribe-line {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    flex-wrap: wrap;
    background: var(--accent-band);
    border: 1px solid var(--accent-rule);
    border-radius: 0;
    padding: 0.55rem 0.75rem;
    margin: 1.25rem 0 1.5rem;
  }

  .subscribe-line .msg {
    font-family: var(--font);
    font-size: 0.85rem;
    line-height: 1.5;
    color: var(--accent-tagline);
    flex: 1;
    min-width: 180px;
    margin: 0;
  }

  .subscribe-line form {
    display: flex;
    gap: 0.4rem;
    flex: 0 0 auto;
    width: 300px;
  }

  /* D — the card at the end of a post. */
  .subscribe-card {
    background: var(--bg2);
    border: 1px solid var(--border);
    border-radius: 0;
    padding: 1rem 1.15rem;
    margin-top: 1.5rem;
  }

  .subscribe-card .t {
    font-family: var(--font-serif);
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--text);
    margin: 0 0 0.25rem;
  }

  .subscribe-card .d {
    font-family: var(--font);
    font-size: 0.85rem;
    line-height: 1.6;
    color: var(--muted);
    margin: 0 0 0.65rem;
  }

  .subscribe-card form {
    display: flex;
    gap: 0.4rem;
    max-width: 360px;
  }

  .subscribe-fine {
    font-family: var(--font-ui);
    font-size: 0.65rem;
    line-height: 1.6;
    color: var(--muted);
    margin: 0.4rem 0 0;
  }

  .subscribe-fine a,
  .subscribe-card .d a {
    color: inherit;
    text-decoration-color: var(--border);
    text-underline-offset: 2px;
  }

  .subscribe-fine a:hover,
  .subscribe-card .d a:hover {
    color: var(--accent);
    text-decoration-color: var(--accent);
  }

  /* Status line. VISUALLY HIDDEN WHEN EMPTY, NOT `display: none`: an
     aria-live region must be in the accessibility tree before text lands, or
     the first error may never be announced. Absolute, so it costs the band no
     row. */
  .newsletter-msg {
    font-family: var(--font-ui);
    font-size: 0.75rem;
    color: var(--muted);
    margin: 0;
    flex-basis: 100%;
  }

  .newsletter-msg:empty {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .newsletter-msg.is-error {
    color: var(--accent-tagline);
  }

  /* :global, because Turnstile rewrites the wrapper's attributes and children. */
  :global(.cf-turnstile:not(:empty)) {
    margin: 0.35rem 0 0;

    /* `width`, not `flex-basis: 100%`: at phone widths the band is a column,
       where flex-basis is the HEIGHT. */
    width: 100%;

    /* Turnstile's `flexible` size has a 300px floor; the band is 256px at a
       320px viewport, which scrolled the PAGE. The box scrolls instead, as
       everywhere else here. Only seen when a challenge is drawn. */
    overflow-x: auto;
  }

  /* Created at runtime by newsletter.js, so it has no scope attribute. */
  :global(.newsletter-success) {
    font-family: var(--font);
    font-style: italic;
    font-size: 0.9rem;
    color: var(--text);
    margin: 0;
  }

  @media (max-width: 639px) {
    .subscribe-line {
      flex-direction: column;
      align-items: stretch;
      gap: 0.55rem;
    }

    .subscribe-line form {
      width: 100%;
    }
  }
</style>
