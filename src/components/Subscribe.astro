---
// The newsletter signup, in both of its placements (design review §5, A + D).
//
// ONE form implementation, two variants:
//
//   variant="line" — a one-line band under the blog index header. The ask
//     before the reader has been given anything, so it stays quiet and stays
//     one line. It is the only accent-band element on the index, which is what
//     earns it the saturation.
//   variant="card" — a tonal card at the end of every published post. The ask
//     after six minutes of reading. --bg2, not accent: it must not outshout the
//     next-post link directly below it.
//
// Replaces NewsletterSignup.astro, whose single placement was the block at the
// bottom of the index (finding 2.2 — heavier than the archive it belonged to).
//
// JS CARVE-OUT, NOW WIDER THAN /blog. This component ships the Turnstile
// loader and /scripts/newsletter.js, and variant="card" puts both on every
// published post as well as the index. That is the deliberate cost of
// placement D. What has NOT changed: it is still absent from every non-blog
// route, still absent from a post rendered as a draft (see BlogPost.astro), and
// still the only client JS outside the galley. Do not lift it into Base.astro
// or any shared chrome — smoke asserts its absence on / for exactly that
// reason.
//
// `import.meta.env.PUBLIC_TURNSTILE_SITE_KEY` is inlined at build time. When
// the value isn't set in the build environment Vite inlines `undefined`, which
// surfaces here at REQUEST time (these routes are on-demand). Rather than throw
// — which would 500 the whole page for visitors — we omit the form and log the
// misconfiguration to Worker observability so it's visible to the operator
// without breaking the page.
interface Props {
  variant?: 'line' | 'card';
}

const { variant = 'card' } = Astro.props;

const siteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
if (!siteKey) {
  console.error(
    'Subscribe: PUBLIC_TURNSTILE_SITE_KEY is not set; omitting form. ' +
    'Local dev: add to mise.local.toml [env]. ' +
    'Production: Cloudflare → Workers → this project → Settings → Build configuration → Variables and Secrets.',
  );
}

// The band has no room for a rendered widget, so there it runs in
// interaction-only mode: Turnstile still executes and still produces the token
// the endpoint verifies, and it only draws itself if a challenge is actually
// required. The card has the room, so it shows the widget as before. Either
// way this is a rendering choice — the anti-spam behaviour is unchanged.
const turnstileAppearance = variant === 'line' ? 'interaction-only' : 'always';
---

{siteKey && (
  <Fragment>
    {variant === 'line' ? (
      <aside class="subscribe-line" aria-labelledby="subscribe-msg">
        <p class="msg" id="subscribe-msg">New issues in your inbox — no tracking.</p>

        <form id="newsletter-form" novalidate>
          <label class="subscribe-sr" for="newsletter-email">Email address</label>
          <input
            id="newsletter-email"
            name="email"
            type="email"
            required
            autocomplete="email"
            inputmode="email"
            placeholder="you@example.com"
          />

          <input
            class="newsletter-hp"
            type="text"
            name="company"
            tabindex="-1"
            autocomplete="off"
            aria-hidden="true"
          />

          <button type="submit">Subscribe</button>
        </form>

        <div
          class="cf-turnstile"
          data-sitekey={siteKey}
          data-theme="light"
          data-size="flexible"
          data-appearance={turnstileAppearance}
        ></div>

        <p class="newsletter-msg" role="status" aria-live="polite"></p>
      </aside>
    ) : (
      <aside class="subscribe-card" aria-labelledby="subscribe-heading">
        <p class="t" id="subscribe-heading">Keep reading the Lexicon</p>
        <p class="d">
          New issues by email — no tracking, one-click unsubscribe.
          Or follow by <a href="/blog/rss.xml">RSS</a>.
        </p>

        <form id="newsletter-form" novalidate>
          <label class="subscribe-sr" for="newsletter-email">Email address</label>
          <input
            id="newsletter-email"
            name="email"
            type="email"
            required
            autocomplete="email"
            inputmode="email"
            placeholder="you@example.com"
          />

          <input
            class="newsletter-hp"
            type="text"
            name="company"
            tabindex="-1"
            autocomplete="off"
            aria-hidden="true"
          />

          <button type="submit">Subscribe</button>
        </form>

        <div
          class="cf-turnstile"
          data-sitekey={siteKey}
          data-theme="light"
          data-size="flexible"
          data-appearance={turnstileAppearance}
        ></div>

        <p class="newsletter-msg" role="status" aria-live="polite"></p>

        {/*
          The spec's fine-print line ends "· or use RSS"; that clause is dropped
          here only because the description directly above already links RSS,
          and two RSS links inside one small card reads as a mistake. The line
          is otherwise verbatim, and it is the whole of the fine print — the
          Turnstile disclosure and the add-me-by-hand offer moved to /privacy.
        */}
        <p class="subscribe-fine">
          Delivered by <a href="https://buttondown.com" rel="noopener">Buttondown</a> ·
          <a href="/privacy">privacy</a>
        </p>
      </aside>
    )}

    <!--
      Submit handler lives as a static asset at /scripts/newsletter.js (under
      public/scripts/). Shipped that way deliberately:
       1. as a static asset it's served by the Cloudflare ASSETS binding and
          loads under our strict `script-src 'self' …` CSP without needing
          'unsafe-inline', per-page hashes, or nonces;
       2. Astro's bundler may inline <script> blocks on on-demand routes
          (especially under the Cloudflare adapter) — shipping the file under
          public/ avoids that variability.
    -->
    <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
    <script type="module" src="/scripts/newsletter.js" is:inline></script>
  </Fragment>
)}

<style>
  /* Both variants share the form's field + button; only the frame differs.
     Kept with the component, like the block it replaces, rather than in
     global.css — these rules have exactly two call sites. */

  .subscribe-sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .newsletter-hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    opacity: 0;
    pointer-events: none;
  }

  .subscribe-line input,
  .subscribe-card input[type='email'] {
    flex: 1;
    min-width: 0;
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 0.38rem 0.55rem;
    font-family: var(--font-ui);
    font-size: 0.75rem;
    background: oklch(99% 0.003 75);
    color: var(--text);
  }

  .subscribe-line input::placeholder,
  .subscribe-card input::placeholder {
    color: var(--muted);
  }

  .subscribe-line button,
  .subscribe-card button {
    background: var(--text);
    color: var(--bg);
    border: 0;
    border-radius: 4px;
    padding: 0.38rem 0.8rem;
    font-family: var(--font-ui);
    font-size: 0.75rem;
    font-weight: 500;
    cursor: pointer;
    white-space: nowrap;
    transition: background 0.15s ease;
  }

  .subscribe-line button:hover,
  .subscribe-card button:hover {
    background: var(--accent-hover);
  }

  .subscribe-line button:disabled,
  .subscribe-card button:disabled {
    opacity: 0.6;
    cursor: progress;
  }

  /* A — the band under the blog index header. */
  .subscribe-line {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    flex-wrap: wrap;
    background: var(--accent-band);
    border: 1px solid var(--accent-rule);
    border-radius: 4px;
    padding: 0.55rem 0.75rem;
    margin: 1.25rem 0 1.5rem;
  }

  .subscribe-line .msg {
    font-family: var(--font);
    font-size: 0.85rem;
    line-height: 1.5;
    color: var(--accent-tagline);
    flex: 1;
    min-width: 180px;
    margin: 0;
  }

  .subscribe-line form {
    display: flex;
    gap: 0.4rem;
    flex: 0 0 auto;
    width: 300px;
  }

  /* D — the card at the end of a post. */
  .subscribe-card {
    background: var(--bg2);
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 1rem 1.15rem;
    margin-top: 1.5rem;
  }

  .subscribe-card .t {
    font-family: var(--font-serif);
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--text);
    margin: 0 0 0.25rem;
  }

  .subscribe-card .d {
    font-family: var(--font);
    font-size: 0.85rem;
    line-height: 1.6;
    color: var(--muted);
    margin: 0 0 0.65rem;
  }

  .subscribe-card form {
    display: flex;
    gap: 0.4rem;
    max-width: 360px;
  }

  .subscribe-fine {
    font-family: var(--font-ui);
    font-size: 0.65rem;
    line-height: 1.6;
    color: var(--muted);
    margin: 0.4rem 0 0;
  }

  .subscribe-fine a,
  .subscribe-card .d a {
    color: inherit;
    text-decoration-color: var(--border);
    text-underline-offset: 2px;
  }

  .subscribe-fine a:hover,
  .subscribe-card .d a:hover {
    color: var(--accent);
    text-decoration-color: var(--accent);
  }

  /* Status line. Empty until the handler writes to it, so it takes no space
     until it has something to say — in the band that matters, since the whole
     placement is one row tall.

     VISUALLY HIDDEN WHEN EMPTY, NOT `display: none`. This is an aria-live
     region, and a live region has to be in the accessibility tree BEFORE the
     text lands in it for the announcement to be reliable — `display: none`
     takes it out, so the first error a screen-reader user hits may never be
     read out. The clip-path idiom (same as .subscribe-sr) keeps it in the tree
     the whole time, and `position: absolute` keeps it out of the band's flex
     flow so it still costs no row and no gap. */
  .newsletter-msg {
    font-family: var(--font-ui);
    font-size: 0.75rem;
    color: var(--muted);
    margin: 0;
    flex-basis: 100%;
  }

  .newsletter-msg:empty {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .newsletter-msg.is-error {
    color: var(--accent-tagline);
  }

  /* Turnstile widget; :global because the third-party script rewrites the
     wrapper's attributes and children — keeping the rule outside Astro's
     scoping guarantees it applies regardless. In the band it is
     interaction-only, so it occupies a full row only when a challenge is
     actually shown. */
  :global(.cf-turnstile:not(:empty)) {
    margin: 0.35rem 0 0;
    flex-basis: 100%;
  }

  /* .newsletter-success is created at runtime by public/scripts/newsletter.js
     (via document.createElement) and replaces the form on success — it has no
     Astro scoping attribute, so :global is required for the rule to match. */
  :global(.newsletter-success) {
    font-family: var(--font);
    font-style: italic;
    font-size: 0.9rem;
    color: var(--text);
    margin: 0;
  }

  @media (max-width: 639px) {
    .subscribe-line {
      flex-direction: column;
      align-items: stretch;
      gap: 0.55rem;
    }

    .subscribe-line form {
      width: 100%;
    }
  }
</style>
