---
// Auto · Light · Dark as three glyphs, rendered ONCE in the masthead folio (on
// screen at every width). Rendered `hidden`: theme.js reveals it, so a reader
// without JS never meets a control that does nothing. Icon-only, so each button
// has an aria-label and a title.
---
<div class="theme-toggle" role="group" aria-label="Colour theme" hidden>
  <button type="button" data-theme-choice="auto" aria-pressed="true" aria-label="Match system theme" title="Match system">
    <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true" focusable="false">
      <circle cx="8" cy="8" r="5.75" fill="none" stroke="currentColor" stroke-width="1.5"/>
      <path d="M8 2.25a5.75 5.75 0 0 1 0 11.5Z" fill="currentColor"/>
    </svg>
  </button>
  <button type="button" data-theme-choice="light" aria-pressed="false" aria-label="Light theme" title="Light">
    <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true" focusable="false">
      <circle cx="8" cy="8" r="3" fill="none" stroke="currentColor" stroke-width="1.5"/>
      <path d="M8 1v1.75M8 13.25V15M1 8h1.75M13.25 8H15M3.05 3.05l1.24 1.24M11.71 11.71l1.24 1.24M3.05 12.95l1.24-1.24M11.71 4.29l1.24-1.24" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
    </svg>
  </button>
  <button type="button" data-theme-choice="dark" aria-pressed="false" aria-label="Dark theme" title="Dark">
    <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true" focusable="false">
      <path d="M13.5 9.6A5.75 5.75 0 1 1 6.4 2.5a4.5 4.5 0 0 0 7.1 7.1Z" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
    </svg>
  </button>
</div>
