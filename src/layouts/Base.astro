---
import '../styles/global.css';
import ContactLinks from '../components/ContactLinks.astro';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Matthew Rossi — senior software engineer and incoming master\'s student in sustainable urban mobility.' } = Astro.props;
const pathname = Astro.url.pathname;

const navLinks = [
  { href: '/work', label: 'Work' },
  { href: '/education', label: 'Education' },
  { href: '/urban-mobility', label: 'Urban Mobility' },
  { href: '/projects', label: 'Projects' },
];
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content={description}>
  <title>{title === 'Matthew Rossi' ? title : `${title} — Matthew Rossi`}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
</head>
<body>

  <nav class="site-nav">
    <div class="site-nav-inner">
      <a href="/" class="name">Matthew Rossi</a>
      <div class="nav-links">
        {navLinks.map(link => (
          <a
            href={link.href}
            class={pathname.startsWith(link.href) ? 'active' : ''}
          >
            {link.label}
          </a>
        ))}
      </div>
    </div>
  </nav>

  <main>
    <slot />
  </main>

  <footer class="site-footer">
    <div class="site-footer-inner">
      <ContactLinks />
    </div>
  </footer>

</body>
</html>
