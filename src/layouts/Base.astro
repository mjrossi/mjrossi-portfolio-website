---
import '../styles/global.css';
import ContactLinks from '../components/ContactLinks.astro';

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
}

const { title, description = 'Matthew Rossi — software engineer turning toward sustainable urban mobility.', noindex = false } = Astro.props;
const pathname = Astro.url.pathname;
const canonical = new URL(pathname, Astro.site).href;
const ogImage = new URL('/og.png', Astro.site).href;
const fullTitle = title === 'Matthew Rossi' ? title : `${title} — Matthew Rossi`;

const navLinks = [
  { href: '/work', label: 'Work' },
  { href: '/education', label: 'Education' },
  { href: '/urban-mobility', label: 'Urban Mobility' },
];
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content={description}>
  {noindex && <meta name="robots" content="noindex">}
  <title>{fullTitle}</title>
  <link rel="canonical" href={canonical}>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">

  <meta property="og:type" content="website">
  <meta property="og:site_name" content="Matthew Rossi">
  <meta property="og:title" content={fullTitle}>
  <meta property="og:description" content={description}>
  <meta property="og:url" content={canonical}>
  <meta property="og:image" content={ogImage}>
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="Matthew Rossi — software engineer turning toward sustainable urban mobility.">

  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={fullTitle}>
  <meta name="twitter:description" content={description}>
  <meta name="twitter:image" content={ogImage}>
  <meta name="twitter:image:alt" content="Matthew Rossi — software engineer turning toward sustainable urban mobility.">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,600&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
</head>
<body>

  <nav class="site-nav">
    <div class="site-nav-inner">
      <a href="/" class="name">Matthew Rossi</a>
      <div class="nav-links">
        {navLinks.map(link => (
          <a
            href={link.href}
            class={pathname.startsWith(link.href) ? 'active' : ''}
          >
            {link.label}
          </a>
        ))}
      </div>
    </div>
  </nav>

  <main>
    <slot />
  </main>

  <footer class="site-footer">
    <div class="site-footer-inner">
      <ContactLinks />
    </div>
  </footer>

</body>
</html>
