---
import { Font } from 'astro:assets';
import '../styles/global.css';
import ContactLinks from '../components/ContactLinks.astro';

type Section = 'home' | 'work' | 'education' | 'urban-mobility' | 'blog' | 'projects' | 'none';

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
  section?: Section;
  pageLabel?: string;
}

const {
  title,
  description = 'Matthew Rossi — software engineer turning toward sustainable urban mobility.',
  noindex = false,
  section = 'none',
  pageLabel,
} = Astro.props;

const pathname = Astro.url.pathname;
const canonical = new URL(pathname, Astro.site).href;
const ogImage = new URL('/og.png', Astro.site).href;
const fullTitle = title === 'Matthew Rossi' ? title : `${title} — Matthew Rossi`;

const now = new Date();
const currentMonthYear = now.toLocaleString('en-US', { month: 'long', year: 'numeric' });

const toRoman = (n: number): string => {
  const map: [number, string][] = [
    [1000, 'M'], [900, 'CM'], [500, 'D'], [400, 'CD'],
    [100, 'C'], [90, 'XC'], [50, 'L'], [40, 'XL'],
    [10, 'X'], [9, 'IX'], [5, 'V'], [4, 'IV'], [1, 'I'],
  ];
  let out = '';
  let rem = n;
  for (const [v, s] of map) {
    while (rem >= v) { out += s; rem -= v; }
  }
  return out;
};

const editionLine = `Vol. ${toRoman(now.getFullYear() - 2024)} · No. ${toRoman(now.getMonth() + 1)} · ${currentMonthYear}`;

const navLinks = [
  { href: '/work', label: 'Work' },
  { href: '/education', label: 'Education' },
  { href: '/urban-mobility', label: 'Urban Mobility' },
  { href: '/blog', label: 'Blog' },
];

const showFullMasthead = section === 'home';
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content={description}>
  {noindex && <meta name="robots" content="noindex">}
  <title>{fullTitle}</title>
  <link rel="canonical" href={canonical}>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">

  <meta property="og:type" content="website">
  <meta property="og:site_name" content="Matthew Rossi">
  <meta property="og:title" content={fullTitle}>
  <meta property="og:description" content={description}>
  <meta property="og:url" content={canonical}>
  <meta property="og:image" content={ogImage}>
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="Matthew Rossi — software engineer turning toward sustainable urban mobility.">

  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={fullTitle}>
  <meta name="twitter:description" content={description}>
  <meta name="twitter:image" content={ogImage}>
  <meta name="twitter:image:alt" content="Matthew Rossi — software engineer turning toward sustainable urban mobility.">

  <Font cssVariable="--font-inter" preload />
  <Font cssVariable="--font-fraunces" preload />
  <Font cssVariable="--font-source-serif" preload />
</head>
<body>

  {showFullMasthead ? (
    <header class="masthead full">
      <div class="masthead-inner">
        <div class="masthead-name-row">
          <h1 class="masthead-name">Matthew <span class="surname">Rossi</span></h1>
          <div class="masthead-meta">
            <span class="masthead-meta-loc">Brooklyn, New York</span>
            <span class="masthead-meta-edition">{editionLine}</span>
          </div>
        </div>
        <div class="masthead-tagline-row">
          <span class="masthead-rule" aria-hidden="true"></span>
          <span class="masthead-tagline">Software engineer turning toward sustainable urban mobility</span>
          <span class="masthead-rule" aria-hidden="true"></span>
        </div>
      </div>
    </header>
  ) : (
    <header class="masthead condensed">
      <div class="masthead-inner">
        <div class="masthead-name-row">
          <a href="/" class="masthead-home-link">Matthew Rossi</a>
          {pageLabel && <span class="masthead-page-label">{pageLabel}</span>}
        </div>
      </div>
    </header>
  )}

  <nav class="broadsheet-nav" aria-label="Primary">
    <div class="broadsheet-nav-inner">
      <div class="page-links">
        {navLinks.map(link => (
          <a
            href={link.href}
            class={pathname === link.href || pathname.startsWith(link.href + '/') ? 'active' : ''}
            aria-current={pathname === link.href || pathname.startsWith(link.href + '/') ? 'page' : undefined}
          >
            {link.label}
          </a>
        ))}
      </div>
      <div class="nav-contact">
        <ContactLinks />
      </div>
    </div>
  </nav>

  <main>
    <slot />
  </main>

  <footer class="broadsheet-footer">
    <div class="broadsheet-footer-inner">
      <div class="footer-contact">
        <ContactLinks />
      </div>
      <span class="broadsheet-colophon">Set in Fraunces &amp; Source Serif · Built in Astro, served from the edge</span>
      <div class="broadsheet-footer-row">
        <span class="footer-left">mjrossi.com</span>
        <span class="footer-right">Brooklyn, New York</span>
      </div>
    </div>
  </footer>

</body>
</html>
