---
import { Font } from 'astro:assets';
import '../styles/global.css';
import ContactLinks from '../components/ContactLinks.astro';
import { issue } from '../lib/edition.js';
import { TAGLINE, SET_IN, BUILT_WITH, SITE_DESCRIPTION } from '../lib/identity.js';

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
  /** Absolute path to a per-page OG card; defaults to the site-level one. */
  ogImage?: string;
  /** Alt text for that card. Defaults to the site description. */
  ogImageAlt?: string;
}

const {
  title,
  description = SITE_DESCRIPTION,
  noindex = false,
  // `?v=` is the cache-bust knob, and it is the only one there is: social
  // scrapers key their stored copy on the full image URL and effectively never
  // re-fetch, so a corrected /og.png does not reach LinkedIn, Facebook, Slack
  // or Bluesky on its own. Bump this whenever public/og.png changes. Keeping
  // the FILENAME stable is what makes it safe — a scraper that strips the
  // query still lands on the current card rather than a 404.
  ogImage: ogImagePath = '/og.png?v=2',
  ogImageAlt = SITE_DESCRIPTION,
} = Astro.props;

const pathname = Astro.url.pathname;
const canonical = new URL(pathname, Astro.site).href;
const ogImage = new URL(ogImagePath, Astro.site).href;
const fullTitle = title === 'Matthew Rossi' ? title : `${title} — Matthew Rossi`;

// ONE call, per render, for the one masthead every page carries. Nothing may
// derive an issue of its own — that divergence is what finding 3.1 caught
// between /blog and everything else. See src/lib/edition.js.
const edition = issue();

// `pinned` is a rendering hint for phone widths only: the nav becomes one
// scrolling row there, and the pinned link stops scrolling with it. It is last
// in this list and last in the DOM, so pinning changes nothing about reading
// order, tab order, or the desktop row — see `.page-links a.nav-pinned` in
// global.css for why the blog is the link that gets it.
const navLinks = [
  { href: '/work', label: 'Work' },
  { href: '/projects', label: 'Projects' },
  { href: '/education', label: 'Education' },
  { href: '/urban-mobility', label: 'Urban Mobility' },
  { href: '/blog', label: 'Blog', pinned: true },
];

const isHome = pathname === '/';
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content={description}>
  {noindex && <meta name="robots" content="noindex">}
  <title>{fullTitle}</title>
  <link rel="canonical" href={canonical}>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">

  <meta property="og:type" content="website">
  <meta property="og:site_name" content="Matthew Rossi">
  <meta property="og:title" content={fullTitle}>
  <meta property="og:description" content={description}>
  <meta property="og:url" content={canonical}>
  <meta property="og:image" content={ogImage}>
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content={ogImageAlt}>

  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={fullTitle}>
  <meta name="twitter:description" content={description}>
  <meta name="twitter:image" content={ogImage}>
  <meta name="twitter:image:alt" content={ogImageAlt}>

  <Font cssVariable="--font-inter" preload />
  <Font cssVariable="--font-fraunces" preload />
  <Font cssVariable="--font-source-serif" preload />
</head>
<body>

  <header class="masthead full">
    <div class="masthead-inner">
      <div class="masthead-name-row">
        {isHome ? (
          <h1 class="masthead-name">Matthew <span class="surname">Rossi</span></h1>
        ) : (
          <a href="/" class="masthead-name masthead-name-link">Matthew <span class="surname">Rossi</span></a>
        )}
        <div class="masthead-meta">
          <span class="masthead-meta-loc">Lisbon, Portugal</span>
          <span class="masthead-meta-edition">{edition.label}</span>
        </div>
      </div>
      <div class="masthead-tagline-row">
        <span class="masthead-rule" aria-hidden="true"></span>
        <span class="masthead-tagline">{TAGLINE}</span>
        <span class="masthead-rule" aria-hidden="true"></span>
      </div>
    </div>
  </header>

  <nav class="broadsheet-nav" aria-label="Primary">
    <div class="broadsheet-nav-inner">
      <div class="page-links">
        {navLinks.map(link => {
          const current = pathname === link.href || pathname.startsWith(link.href + '/');
          return (
            <a
              href={link.href}
              class:list={[{ active: current, 'nav-pinned': link.pinned }]}
              aria-current={current ? 'page' : undefined}
            >
              {link.label}
            </a>
          );
        })}
      </div>
      <div class="nav-contact">
        <ContactLinks />
      </div>
    </div>
  </nav>

  <main>
    <slot />
  </main>

  <footer class="broadsheet-footer">
    <div class="broadsheet-footer-inner">
      <div class="footer-contact">
        <ContactLinks />
      </div>
      <span class="broadsheet-colophon">{SET_IN} · {BUILT_WITH}</span>
      <div class="broadsheet-footer-row">
        <span class="footer-left">mjrossi.com</span>
        <span class="footer-right">Lisbon, Portugal</span>
      </div>
    </div>
  </footer>

</body>
</html>
