---
import { Font } from 'astro:assets';
import '../styles/global.css';
import ContactLinks from '../components/ContactLinks.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import { issue } from '../lib/edition.js';
import { TAGLINE, LEXICON_TAGLINE, SET_IN, BUILT_WITH, SITE_DESCRIPTION, CARD_DESCRIPTION } from '../lib/identity.js';

interface Crumb {
  label: string;
  href?: string;
}

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
  /** Absolute path to a per-page OG card; defaults to the site-level one. */
  ogImage?: string;
  /** Alt text for that card. Defaults to CARD_DESCRIPTION. */
  ogImageAlt?: string;
  /** `author` everywhere but the blog; `lexicon` (author as byline) on every blog route. */
  masthead?: 'author' | 'lexicon';
  /** The kicker's breadcrumb. Omitted on the two fronts (`/`, `/blog`) and on posts. */
  crumbs?: Crumb[];
  /** Load /scripts/theme.js. Off only for the Desk, which ships no client JS. */
  themeScript?: boolean;
  /**
   * The <head> without masthead, nav, kicker or footer: /card and /card/qr
   * only, where a second masthead would be two wordmarks on one phone screen.
   */
  bare?: boolean;
  /** og:/twitter: title when it should differ from <title> (/card, /card/qr). */
  ogTitle?: string;
}

const {
  title,
  description: pageDescription,
  noindex = false,
  // `?v=` is the only cache-bust: scrapers key on the full image URL and never
  // re-fetch. Bump it whenever public/og.png changes; the stable filename means
  // a scraper that drops the query still gets the current card.
  ogImage: ogImagePath = '/og.png?v=4',
  ogImageAlt = CARD_DESCRIPTION,
  masthead = 'author',
  crumbs,
  themeScript = true,
  bare = false,
  ogTitle,
} = Astro.props;

// Search engines re-crawl `<meta name="description">`, so it may say TAGLINE;
// link previews are kept indefinitely, so og:/twitter: get the identity line.
const description = pageDescription ?? SITE_DESCRIPTION;
const previewDescription = pageDescription ?? CARD_DESCRIPTION;

const pathname = Astro.url.pathname;
const canonical = new URL(pathname, Astro.site).href;
const ogImage = new URL(ogImagePath, Astro.site).href;
const fullTitle = title === 'Matthew Rossi' ? title : `${title} — Matthew Rossi`;
const previewTitle = ogTitle ?? fullTitle;

// ONE call per render. Nothing may derive an issue of its own (see edition.js).
const edition = issue();

// `pinned` is a phone-width hint: the nav scrolls in one row and this link
// stays put. Last in the DOM, so reading and tab order are unchanged.
const navLinks = [
  { href: '/work', label: 'Work', roman: 'i.' },
  { href: '/projects', label: 'Projects', roman: 'ii.' },
  { href: '/education', label: 'Education', roman: 'iii.' },
  { href: '/urban-mobility', label: 'Urban Mobility', roman: 'iv.' },
  { href: '/blog', label: 'Blog', roman: 'v.', pinned: true },
];

const isHome = pathname === '/';
const isLexicon = masthead === 'lexicon';
// The name is the <h1> only on a front (`/`, `/blog`); elsewhere it links there.
const isFront = isLexicon ? pathname === '/blog' || pathname === '/blog/' : isHome;
const frontHref = isLexicon ? '/blog' : '/';
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content={description}>
  {noindex && <meta name="robots" content="noindex">}
  <title>{fullTitle}</title>
  <link rel="canonical" href={canonical}>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <meta name="color-scheme" content="light dark">
  {/* Synchronous on purpose: it sets data-theme before first paint. See the file. */}
  {themeScript && <script is:inline src="/scripts/theme.js"></script>}

  <meta property="og:type" content="website">
  <meta property="og:site_name" content="Matthew Rossi">
  <meta property="og:title" content={previewTitle}>
  <meta property="og:description" content={previewDescription}>
  <meta property="og:url" content={canonical}>
  <meta property="og:image" content={ogImage}>
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content={ogImageAlt}>

  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={previewTitle}>
  <meta name="twitter:description" content={previewDescription}>
  <meta name="twitter:image" content={ogImage}>
  <meta name="twitter:image:alt" content={ogImageAlt}>

  <Font cssVariable="--font-inter" preload />
  <Font cssVariable="--font-fraunces" preload />
  <Font cssVariable="--font-source-serif" preload />
</head>
<body>

  {!bare && (<>
  <header class="masthead full" data-masthead={masthead}>
    <div class="masthead-inner">
      <div class="masthead-folio">
        {isLexicon ? (
          <span class="masthead-folio-left">By <a href="/">Matthew Rossi</a><span class="dot" aria-hidden="true">·</span>Lisbon, Portugal</span>
        ) : (
          <span class="masthead-folio-left">Lisbon, Portugal</span>
        )}
        <span class="masthead-folio-right">
          <span class="masthead-meta-edition">{edition.label}</span>
          <ThemeToggle />
        </span>
      </div>
      {isFront ? (
        <h1 class="masthead-name">
          {isLexicon ? <>The Urbanist <span class="surname">Lexicon</span></> : <>Matthew <span class="surname">Rossi</span></>}
        </h1>
      ) : (
        <a href={frontHref} class="masthead-name masthead-name-link">
          {isLexicon ? <>The Urbanist <span class="surname">Lexicon</span></> : <>Matthew <span class="surname">Rossi</span></>}
        </a>
      )}
      <div class="masthead-tagline-row">
        <span class="masthead-rule" aria-hidden="true"></span>
        <span class="masthead-tagline">{isLexicon ? LEXICON_TAGLINE : TAGLINE}</span>
        <span class="masthead-rule" aria-hidden="true"></span>
      </div>
    </div>
  </header>

  <nav class="broadsheet-nav" aria-label="Primary">
    <div class="broadsheet-nav-inner">
      <div class="page-links">
        {navLinks.map(link => {
          const current = pathname === link.href || pathname.startsWith(link.href + '/');
          return (
            <a
              href={link.href}
              class:list={[{ active: current, 'nav-pinned': link.pinned }]}
              aria-current={current ? 'page' : undefined}
            >
              <span class="roman" aria-hidden="true">{link.roman}</span>{link.label}
            </a>
          );
        })}
      </div>
      <div class="nav-contact">
        <ContactLinks />
      </div>
    </div>
  </nav>

  {crumbs && crumbs.length > 0 && (
    <div class="kicker-band">
      <nav class="kicker" aria-label="Breadcrumb">
        <ol>
          {crumbs.map((c, i) => (
            <li>
              {i > 0 && <span class="crumb-sep" aria-hidden="true">›</span>}
              {c.href ? <a href={c.href}>{c.label}</a> : <span aria-current="page">{c.label}</span>}
            </li>
          ))}
        </ol>
      </nav>
    </div>
  )}
  </>)}

  <main class:list={[{ bare }]}>
    <slot />
  </main>

  {!bare && (
  <footer class="site-foot">
    <div class="site-foot-inner">
      <div class="site-foot-grid">
        <div class="site-foot-colophon">
          <p class="colophon-title">Matthew <span class="em">Rossi</span></p>
          <p class="colophon-tag">{TAGLINE}.</p>
          <div class="footer-contact">
            <ContactLinks />
          </div>
        </div>
        <div>
          <h2 class="site-foot-heading">Pages</h2>
          <ul>
            <li><a href="/">Front</a></li>
            {navLinks.filter((l) => !l.pinned).map((l) => <li><a href={l.href}>{l.label}</a></li>)}
          </ul>
        </div>
        <div>
          <h2 class="site-foot-heading">The Lexicon</h2>
          <ul>
            <li><a href="/blog">All issues</a></li>
            <li><a href="/blog/tags">Topics</a></li>
            <li><a href="/blog/rss.xml">RSS</a></li>
          </ul>
        </div>
        <div>
          <h2 class="site-foot-heading">Elsewhere</h2>
          <ul>
            <li><a href="https://urbanistatlas.com">Urbanist Atlas</a></li>
            <li><a href="/privacy">Privacy</a></li>
          </ul>
        </div>
      </div>
      <div class="colophon-strip">
        <span class="broadsheet-colophon">{SET_IN} · {BUILT_WITH}</span>
        <span>mjrossi.com · Lisbon, Portugal</span>
      </div>
    </div>
  </footer>
  )}

</body>
</html>
