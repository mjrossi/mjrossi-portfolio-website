---
import { Font } from 'astro:assets';
import '../styles/global.css';
import ContactLinks from '../components/ContactLinks.astro';
import { issue } from '../lib/edition.js';

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
  /**
   * 'full' is the front page's signature: display name, location + edition
   * line, italic tagline between rules, then nav *and* a contact row. Every
   * other page gets 'compact' — wordmark, issue, nav, one heavy rule — which
   * is why the default is the interior variant rather than the home one: a new
   * page that forgets the prop should get the quiet masthead, not the
   * five-band one. See finding 3.2 in the August 2026 design review.
   */
  masthead?: 'full' | 'compact';
  /** Absolute path to a per-page OG card; defaults to the site-level one. */
  ogImage?: string;
  /** Alt text for that card. Defaults to the site description. */
  ogImageAlt?: string;
}

const SITE_ALT = 'Matthew Rossi — software engineer turning toward sustainable urban mobility.';

const {
  title,
  description = 'Matthew Rossi — software engineer turning toward sustainable urban mobility.',
  noindex = false,
  masthead = 'compact',
  ogImage: ogImagePath = '/og.png',
  ogImageAlt = SITE_ALT,
} = Astro.props;

const pathname = Astro.url.pathname;
const canonical = new URL(pathname, Astro.site).href;
const ogImage = new URL(ogImagePath, Astro.site).href;
const fullTitle = title === 'Matthew Rossi' ? title : `${title} — Matthew Rossi`;

// ONE call, per render, for both variants. The full masthead prints the label,
// the compact one prints the short form, and neither derives an issue of its
// own — that divergence is exactly what finding 3.1 caught between /blog and
// everything else. See src/lib/edition.js.
const edition = issue();

const isFullMasthead = masthead === 'full';

const navLinks = [
  { href: '/work', label: 'Work' },
  { href: '/projects', label: 'Projects' },
  { href: '/education', label: 'Education' },
  { href: '/urban-mobility', label: 'Urban Mobility' },
  { href: '/blog', label: 'Blog' },
];

const isHome = pathname === '/';
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content={description}>
  {noindex && <meta name="robots" content="noindex">}
  <title>{fullTitle}</title>
  <link rel="canonical" href={canonical}>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">

  <meta property="og:type" content="website">
  <meta property="og:site_name" content="Matthew Rossi">
  <meta property="og:title" content={fullTitle}>
  <meta property="og:description" content={description}>
  <meta property="og:url" content={canonical}>
  <meta property="og:image" content={ogImage}>
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content={ogImageAlt}>

  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={fullTitle}>
  <meta name="twitter:description" content={description}>
  <meta name="twitter:image" content={ogImage}>
  <meta name="twitter:image:alt" content={ogImageAlt}>

  <Font cssVariable="--font-inter" preload />
  <Font cssVariable="--font-fraunces" preload />
  <Font cssVariable="--font-source-serif" preload />
</head>
<body>

  {/*
    NAV FIRST, ON EVERY PAGE, AND THIS ORDER IS THE POINT.

    With the masthead above it, the nav sat at y=144 on the front page and y=62
    everywhere else — an 85px jump on every navigation away from home. Click
    "Work" and your cursor lands 85px below the nav on the page you arrive at,
    over the content, so reaching a second section means going back up. Print
    varies the flag between page one and inside pages, but print is not clicked;
    on the web the nav is the thing that has to stay put.

    So the strip is identical on every page — same content, same height, same
    y — and the masthead varies beneath it. That is also why the contact row is
    gone from here entirely (finding 4.2): the footer carries all four on every
    page, and icons that appeared on one page's strip and not another's would
    reintroduce the difference this order exists to remove.
  */}
  <nav class="broadsheet-nav" aria-label="Primary">
    <div class="broadsheet-nav-inner">
      <div class="page-links">
        {navLinks.map(link => (
          <a
            href={link.href}
            class={pathname === link.href || pathname.startsWith(link.href + '/') ? 'active' : ''}
            aria-current={pathname === link.href || pathname.startsWith(link.href + '/') ? 'page' : undefined}
          >
            {link.label}
          </a>
        ))}
      </div>
    </div>
  </nav>

  {isFullMasthead ? (
    <header class="masthead full">
      <div class="masthead-inner">
        <div class="masthead-name-row">
          {isHome ? (
            <h1 class="masthead-name">Matthew <span class="surname">Rossi</span></h1>
          ) : (
            <a href="/" class="masthead-name masthead-name-link">Matthew <span class="surname">Rossi</span></a>
          )}
          <div class="masthead-meta">
            <span class="masthead-meta-loc">Lisbon, Portugal</span>
            <span class="masthead-meta-edition">{edition.label}</span>
          </div>
        </div>
        <div class="masthead-tagline-row">
          <span class="masthead-rule" aria-hidden="true"></span>
          <span class="masthead-tagline">Software engineer turning toward sustainable urban mobility</span>
          <span class="masthead-rule" aria-hidden="true"></span>
        </div>
      </div>
    </header>
  ) : (
    <header class="masthead compact">
      <div class="masthead-inner">
        <div class="masthead-compact-row">
          <a href="/" class="masthead-wordmark">Matthew <span class="surname">Rossi</span></a>
          <span class="masthead-issue">{edition.short}</span>
        </div>
      </div>
    </header>
  )}

  <main>
    <slot />
  </main>

  <footer class="broadsheet-footer">
    <div class="broadsheet-footer-inner">
      <div class="footer-contact">
        <ContactLinks />
      </div>
      <span class="broadsheet-colophon">Set in Fraunces &amp; Source Serif · Built in Astro, served from the edge</span>
      <div class="broadsheet-footer-row">
        <span class="footer-left">mjrossi.com</span>
        <span class="footer-right">Lisbon, Portugal</span>
      </div>
    </div>
  </footer>

</body>
</html>
