---
import { Image } from 'astro:assets';
import Base from './Base.astro';
import { dateFormatter, isoDate, postReadingTime, type Post } from '../lib/blog.ts';

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { title, description, pubDate, updatedDate, tags, cover } = post.data;
const readLabel = postReadingTime(post);
---

<Base
  title={title}
  description={description}
  section="none"
  pageLabel="Blog"
>
  <article class="page post">
    <a href="/blog" class="post-back post-back-top">← Blog</a>

    <header class="post-header">
      <h1 class="post-title">{title}</h1>
      <p class="post-meta">
        <time datetime={isoDate(pubDate)}>{dateFormatter.format(pubDate)}</time>
        <span class="meta-sep" aria-hidden="true">·</span>
        <span>{readLabel}</span>
        {updatedDate && (
          <>
            <span class="meta-sep" aria-hidden="true">·</span>
            <span class="post-updated">
              Updated <time datetime={isoDate(updatedDate)}>{dateFormatter.format(updatedDate)}</time>
            </span>
          </>
        )}
      </p>
      {tags.length > 0 && (
        <p class="post-tags">
          {tags.map((tag) => (
            <a href={`/blog/tag/${tag}/`} class="tag-chip">{tag}</a>
          ))}
        </p>
      )}
      {cover && (
        <figure class="post-cover">
          <Image src={cover.src} alt={cover.alt} loading="eager" />
        </figure>
      )}
    </header>

    <div class="post-body">
      <slot />
    </div>

    <footer class="post-footer">
      {tags.length > 0 ? (
        <p class="post-tags">
          {tags.map((tag) => (
            <a href={`/blog/tag/${tag}/`} class="tag-chip">{tag}</a>
          ))}
        </p>
      ) : <span></span>}
      <a href="/blog" class="post-back post-back-bottom">← All posts</a>
    </footer>
  </article>
</Base>
