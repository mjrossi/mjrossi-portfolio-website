---
import { Image } from 'astro:assets';
import Base from './Base.astro';
import PostTags from '../components/PostTags.astro';
import PostTopic from '../components/PostTopic.astro';
import PostNav from '../components/PostNav.astro';
import Subscribe from '../components/Subscribe.astro';
import GalleyMargin from '../components/GalleyMargin.astro';
import { dateFormatter, getAdjacentPosts, isoDate, postReadingTime, type Post } from '../lib/blog.ts';
import { isPublished } from '../lib/schedule.js';
import { revisionOf } from '../lib/post-source.ts';

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { title, description, pubDate, updatedDate, tags, cover } = post.data;
const readLabel = postReadingTime(post);

const { previous, next } = await getAdjacentPosts(post.id, {
  showScheduled: Astro.locals.showScheduled,
});

// See BlogPostEntry.astro — keyed off the pubDate, not the preview flag.
const scheduled = !isPublished(pubDate);

// The galley renders only for a signed preview link that named a reviewer, only
// on the post that link authorises, and only while that post is still a draft.
// All three matter: previewReviewer alone would put the review chrome on every
// post the reader can reach, and middleware only guarantees no-store + noindex
// on responses where a preview signal is live. This gate is the reason the
// second client-JS carve-out can never appear on a publicly cacheable page —
// smoke asserts it.
//
// `scheduled` is the belt to a brace applied at mint time. `just preview-link`
// caps a link's expiry at pubDate, so a link normally expires as its post goes
// live and never reaches this gate; that cap is a snapshot, though, and moving
// pubDate EARLIER afterwards is exactly what the authoring workflow does at step
// 5. This is what stops a link outstanding from that move holding the review
// margin open over a published post. /api/galley enforces the same rule, because
// this one is a UI condition and authorisation cannot live in the UI.
const reviewer =
  Astro.locals.previewReviewer && Astro.locals.previewSlug === post.id && scheduled
    ? Astro.locals.previewReviewer
    : null;

// The revision this page is rendering, handed to the margin so a note can be
// tied to the source it was actually written against. /api/galley refuses a note
// whose page has since moved, and the client uses it to know when every anchor
// on screen has gone stale at once.
//
// Computed only for a review render — hashing every post's raw MDX on an
// ordinary request would be work no reader benefits from — and through the same
// src/lib/post-source.ts the endpoint uses, because a hash that disagreed with
// the endpoint's would refuse every write.
const revision = reviewer ? ((await revisionOf(post.id)) ?? null) : null;
---

<Base
  title={title}
  description={description}
  ogImage={scheduled ? undefined : `/og/${post.id}.png`}
  ogImageAlt={scheduled ? undefined : title}
>
  <article class="page post">
    <a href="/blog" class="post-back post-back-top">← Blog</a>

    <header class="post-header">
      <h1 class="post-title">{title}</h1>
      {/*
        One topic in the meta line, not the full chip row (finding 1.4). Six
        chips used to stack between the title and the first word of prose —
        the loudest coloured thing on the page, doing discovery work at the
        moment the reader wants to start reading. The full set is in the
        footer under "Filed under", where discovery belongs.
      */}
      <p class="post-meta">
        {scheduled && (
          <span class="post-scheduled">Scheduled</span>
        )}
        <time datetime={isoDate(pubDate)}>{dateFormatter.format(pubDate)}</time>
        <span class="meta-sep" aria-hidden="true">·</span>
        <span>{readLabel}</span>
        {updatedDate && (
          <>
            <span class="meta-sep" aria-hidden="true">·</span>
            <span class="post-updated">
              Updated <time datetime={isoDate(updatedDate)}>{dateFormatter.format(updatedDate)}</time>
            </span>
          </>
        )}
        <PostTopic tags={tags} />
      </p>
      {cover && (
        <figure class="post-cover">
          <Image src={cover.src} alt={cover.alt} loading="eager" />
          {cover.caption && <figcaption>{cover.caption}</figcaption>}
        </figure>
      )}
    </header>

    <div class="post-body">
      <slot />
    </div>

    <footer class="post-footer">
      <PostTags tags={tags} label="Filed under" />

      {/*
        Placement D, then the chronological neighbours (§5, finding 1.5). Order
        matters: the subscribe card is tonal precisely so it does not outshout
        the next post below it.

        Both are skipped while a post is still a draft. A galley reader is here
        to review prose, not to be sold a subscription, and a draft's neighbours
        are whatever the archive happens to hold — the post itself is not in it
        yet, so "previous/next" would be answering about a different sequence
        than the one the published post will land in.
      */}
      {!scheduled && (
        <>
          <Subscribe variant="card" />
          <PostNav previous={previous} next={next} />
          <a href="/blog" class="post-back post-back-all">All posts</a>
        </>
      )}

      {scheduled && <a href="/blog" class="post-back post-back-bottom">← All posts</a>}
    </footer>
  </article>

  {reviewer && <GalleyMargin slug={post.id} reviewer={reviewer} revision={revision} />}
</Base>
