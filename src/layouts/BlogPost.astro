---
import { Image } from 'astro:assets';
import Base from './Base.astro';
import PostTags from '../components/PostTags.astro';
import GalleyMargin from '../components/GalleyMargin.astro';
import { dateFormatter, isoDate, postReadingTime, type Post } from '../lib/blog.ts';
import { isPublished } from '../lib/schedule.js';

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { title, description, pubDate, updatedDate, tags, cover } = post.data;
const readLabel = postReadingTime(post);

// See BlogPostEntry.astro — keyed off the pubDate, not the preview flag.
const scheduled = !isPublished(pubDate);

// The galley renders only for a signed preview link that named a reviewer, and
// only on the post that link authorises. Both halves matter: previewReviewer
// alone would put the review chrome on every post the reader can reach, and
// middleware only guarantees no-store + noindex on responses where a preview
// signal is live. This gate is the reason the second client-JS carve-out can
// never appear on a publicly cacheable page — smoke asserts it.
const reviewer =
  Astro.locals.previewReviewer && Astro.locals.previewSlug === post.id
    ? Astro.locals.previewReviewer
    : null;
---

<Base
  title={title}
  description={description}
>
  <article class="page post">
    <a href="/blog" class="post-back post-back-top">← Blog</a>

    <header class="post-header">
      <h1 class="post-title">{title}</h1>
      <p class="post-meta">
        {scheduled && (
          <span class="post-scheduled">Scheduled</span>
        )}
        <time datetime={isoDate(pubDate)}>{dateFormatter.format(pubDate)}</time>
        <span class="meta-sep" aria-hidden="true">·</span>
        <span>{readLabel}</span>
        {updatedDate && (
          <>
            <span class="meta-sep" aria-hidden="true">·</span>
            <span class="post-updated">
              Updated <time datetime={isoDate(updatedDate)}>{dateFormatter.format(updatedDate)}</time>
            </span>
          </>
        )}
      </p>
      <PostTags tags={tags} />
      {cover && (
        <figure class="post-cover">
          <Image src={cover.src} alt={cover.alt} loading="eager" />
          {cover.caption && <figcaption>{cover.caption}</figcaption>}
        </figure>
      )}
    </header>

    <div class="post-body">
      <slot />
    </div>

    <footer class="post-footer">
      {tags.length > 0 ? <PostTags tags={tags} /> : <span></span>}
      <a href="/blog" class="post-back post-back-bottom">← All posts</a>
    </footer>
  </article>

  {reviewer && <GalleyMargin slug={post.id} reviewer={reviewer} />}
</Base>
