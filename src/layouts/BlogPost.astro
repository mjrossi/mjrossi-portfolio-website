---
import { Image } from 'astro:assets';
import Base from './Base.astro';
import PostTags from '../components/PostTags.astro';
import PostTopics from '../components/PostTopics.astro';
import PostNav from '../components/PostNav.astro';
import Subscribe from '../components/Subscribe.astro';
import GalleyMargin from '../components/GalleyMargin.astro';
import { dateFormatter, getAdjacentPosts, isoDate, postReadingTime, type Post } from '../lib/blog.ts';
import { isPublished } from '../lib/schedule.js';
import { revisionOf } from '../lib/post-source.ts';

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { title, description, pubDate, updatedDate, tags, cover } = post.data;
const readLabel = postReadingTime(post);

const { previous, next } = await getAdjacentPosts(post.id, {
  showScheduled: Astro.locals.showScheduled,
});

// See BlogPostEntry.astro — keyed off the pubDate, not the preview flag.
const scheduled = !isPublished(pubDate);

// Whether /og/<slug>.png exists — not the same as `scheduled`. The generator
// skips drafts, and a post can go live with no rebuild, so ask with the BUILD's
// clock or og:image would point at a card never generated.
const hasCard = isPublished(pubDate, __BUILD_TIME__);

// The galley renders only for a link that named a reviewer, only on the post
// it authorises, and only while that post is a draft. This gate is why the
// galley JS can never reach a publicly cacheable page; smoke asserts it.
// `scheduled` covers a pubDate moved EARLIER after minting. /api/galley
// enforces the same rule, since authorisation can't live in the UI.
const reviewer =
  Astro.locals.previewReviewer && Astro.locals.previewSlug === post.id && scheduled
    ? Astro.locals.previewReviewer
    : null;

// The revision being rendered, for the margin. Only computed for a review
// render, through the same post-source.ts as the endpoint.
const revision = reviewer ? ((await revisionOf(post.id)) ?? null) : null;
---

<Base
  masthead="lexicon"
  title={title}
  description={description}
  ogImage={hasCard ? `/og/${post.id}.png` : undefined}
  ogImageAlt={hasCard ? title : undefined}
>
  <article class="page post">
    <a href="/blog" class="post-back post-back-top">← Blog</a>

    <header class="post-header">
      <h1 class="post-title">{title}</h1>
      {/* Two topics here; the full set is in the footer, under "Filed under". */}
      <p class="post-meta">
        {scheduled && (
          <span class="post-scheduled">Scheduled</span>
        )}
        <time datetime={isoDate(pubDate)}>{dateFormatter.format(pubDate)}</time>
        <span class="meta-sep" aria-hidden="true">·</span>
        <span>{readLabel}</span>
        {updatedDate && (
          <>
            <span class="meta-sep" aria-hidden="true">·</span>
            <span class="post-updated">
              Updated <time datetime={isoDate(updatedDate)}>{dateFormatter.format(updatedDate)}</time>
            </span>
          </>
        )}
        <PostTopics tags={tags} />
      </p>
      {cover && (
        <figure class="post-cover">
          <Image src={cover.src} alt={cover.alt} loading="eager" />
          {cover.caption && <figcaption>{cover.caption}</figcaption>}
        </figure>
      )}
    </header>

    <div class="post-body">
      <slot />
    </div>

    <footer class="post-footer">
      <PostTags tags={tags} label="Filed under" />

      {/*
        Subscribe, then previous/next; the card is tonal so it doesn't outshout
        the next post. Both skipped on a draft: a reviewer isn't to be sold a
        subscription, and a draft isn't in the sequence yet.
      */}
      {!scheduled && (
        <>
          <Subscribe variant="card" />
          {/*
            The blocker fallback stays OUT of Subscribe.astro, whose <aside> is
            what ad-blockers hide and which renders nothing without the site key.
            It keeps RSS: a post's header has no RSS pill.
          */}
          <p class="blog-follow-note">
            Or follow by <a href="/blog/rss.xml">RSS</a> · <a href="/api/contact">email me</a> to be added by hand
          </p>
          <PostNav previous={previous} next={next} />
          <a href="/blog" class="post-back post-back-all">All posts</a>
        </>
      )}

      {scheduled && <a href="/blog" class="post-back post-back-bottom">← All posts</a>}
    </footer>
  </article>

  {reviewer && <GalleyMargin slug={post.id} reviewer={reviewer} revision={revision} />}
</Base>
