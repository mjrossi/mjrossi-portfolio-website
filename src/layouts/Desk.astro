---
// The Desk's chrome, for the Access-gated pages under /admin: Base, plus the
// density of a page read on a phone answering "what is outstanding?".
//
// Its styles live here, not in global.css (which ships on every public page);
// only /admin imports this, so they stay off the public bundle. Smoke asserts
// it. `is:global`, because the markup is rendered in the PAGE's scope, so scoped
// rules here wouldn't match; safe because the module graph confines it.
import Base from './Base.astro';

interface Props {
  title: string;
  /** Shown under the heading. */
  subtitle?: string;
  /** Rendered as a back link when the page is not the Desk index. */
  back?: { href: string; label: string };
}

const { title, subtitle, back } = Astro.props;
const { admin } = Astro.locals;
---

{/* noindex too: the header is what matters, but a meta tag survives a saved page. */}
<Base title={title} description="Operator desk" noindex={true} themeScript={false}>
  <div class="page desk">
    <header class="desk-header">
      {back && (
        <p class="desk-back"><a href={back.href}>&larr; {back.label}</a></p>
      )}
      <h1>{title}</h1>
      {subtitle && <p class="desk-subtitle">{subtitle}</p>}
      <p class="desk-who">
        {/* Not a gate: a visible identity is how you notice the wrong account. */}
        {admin?.email ?? 'signed in'} · <span class="desk-warning">not cached, not indexed</span>
      </p>
    </header>

    <slot />
  </div>
</Base>

<style is:global>
  .desk {
    --desk-gap: 0.65rem;
  }

  .desk-header {
    margin-bottom: 2rem;
    padding-bottom: 1rem;
    border-bottom: 3px double var(--accent-band-border, var(--border));
  }

  .desk-back {
    margin: 0 0 0.5rem;
    font-family: var(--font-ui);
    font-size: 0.8rem;
  }

  .desk-header h1 {
    margin: 0;
    font-family: var(--font-serif);
    font-size: clamp(1.8rem, 5vw, 2.6rem);
    line-height: 1.1;
  }

  .desk-subtitle {
    margin: 0.4rem 0 0;
    color: var(--muted);
  }

  .desk-who {
    margin: 0.75rem 0 0;
    font-family: var(--font-ui);
    font-size: 0.75rem;
    color: var(--muted);
    font-variant-caps: all-small-caps;
    letter-spacing: 0.06em;
  }

  .desk-warning {
    color: var(--accent);
  }

  .desk-section {
    margin-bottom: 2.5rem;
  }

  .desk-section > h2 {
    margin: 0 0 0.35rem;
    font-family: var(--font-ui);
    font-size: 0.8rem;
    font-variant-caps: all-small-caps;
    letter-spacing: 0.1em;
    color: var(--muted);
  }

  .desk-section > .desk-note {
    margin: 0 0 1rem;
    font-size: 0.9rem;
    color: var(--muted);
  }

  /* Cards, not a table: five columns on a phone scroll or shrink past legibility. */
  .desk-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--desk-gap);
  }

  .desk-card {
    display: block;
    padding: 0.85rem 1rem;
    border: 1px solid var(--border);
    background: var(--bg2);
    text-decoration: none;
    color: inherit;
  }

  a.desk-card:hover {
    border-color: var(--accent);
  }

  .desk-card-title {
    font-family: var(--font-serif);
    font-size: 1.05rem;
    line-height: 1.25;
    margin: 0 0 0.3rem;
  }

  .desk-card-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 0.9rem;
    font-family: var(--font-ui);
    font-size: 0.78rem;
    color: var(--muted);
  }

  /* Counts that matter get the accent; zero stays quiet. */
  .desk-count-live {
    color: var(--accent);
    font-weight: 600;
  }

  .desk-badge {
    font-family: var(--font-ui);
    font-size: 0.7rem;
    font-variant-caps: all-small-caps;
    letter-spacing: 0.08em;
    padding: 0.05rem 0.45rem;
    border: 1px solid var(--border);
    white-space: nowrap;
  }

  .desk-badge-scheduled {
    border-color: var(--accent);
    color: var(--accent);
  }

  /* Monospace: ids are compared by eye against preview-roster's output. */
  .desk-links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.4rem;
  }

  .desk-link {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.3rem 0.8rem;
    padding: 0.55rem 0.75rem;
    border: 1px solid var(--border);
    font-family: var(--font-ui);
    font-size: 0.8rem;
  }

  .desk-link-id {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.78rem;
    -webkit-user-select: all;
    user-select: all;
  }

  .desk-link-who {
    color: var(--muted);
  }

  /* An orphan slug is a link (its only route to a roster), coloured explicitly
     because .desk-link-who would otherwise beat the global `a` rule. */
  a.desk-link-who {
    color: var(--accent);
  }

  .desk-state {
    font-variant-caps: all-small-caps;
    letter-spacing: 0.06em;
  }

  .desk-state-live { color: var(--accent); font-weight: 600; }
  .desk-state-expired,
  .desk-state-revoked,
  .desk-state-spent { color: var(--muted); }

  .desk-empty {
    margin: 0;
    padding: 0.85rem 1rem;
    border: 1px dashed var(--border);
    color: var(--muted);
    font-size: 0.9rem;
  }

  /* Wrap rather than scroll: a half-visible command is worse. */
  .desk-cmd {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.78rem;
    background: var(--bg2);
    border: 1px solid var(--border);
    padding: 0.15rem 0.35rem;
    overflow-wrap: anywhere;
    -webkit-user-select: all;
    user-select: all;
  }
</style>
