---
import Base from '../layouts/Base.astro';

export const prerender = true;
---

<Base title="Not found" description="The page you're looking for doesn't exist." noindex>

  <div class="page">
    <div class="page-header">
      <h1>Not found</h1>
      <p>That page doesn't exist. Try <a href="/">the home page</a>.</p>
    </div>
  </div>

</Base>
