---
import { getCollection, render } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';
import { getPublishedPosts } from '../../lib/blog.ts';

const { slug } = Astro.params;
const { showScheduled, previewSlug } = Astro.locals;

const posts = await getPublishedPosts({ showScheduled });
let post = posts.find((p) => p.id === slug);

// Signed preview link: reveals exactly the post it names, and nothing else.
// The `previewSlug === slug` equality is the scoping guarantee — a link minted
// for one draft cannot be edited to open another, because the slug is part of
// the signed payload. This is the only route that honours the token; the
// index, tag pages, and RSS feed stay production-clean.
if (!post && previewSlug && previewSlug === slug) {
  post = (await getCollection('blog')).find((p) => p.id === slug);
}

if (!post) {
  return new Response('Not Found', { status: 404 });
}

const { Content } = await render(post);
---

<BlogPost post={post}>
  <Content />
</BlogPost>
