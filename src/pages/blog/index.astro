---
import Base from '../../layouts/Base.astro';
import BlogPostEntry from '../../components/BlogPostEntry.astro';
import NewsletterSignup from '../../components/NewsletterSignup.astro';
import { getPublishedPosts } from '../../lib/blog.ts';

export const prerender = false;
Astro.response.headers.set('Cache-Control', 'public, max-age=3600');

const posts = await getPublishedPosts();
const postCountLabel = `${posts.length} post${posts.length === 1 ? '' : 's'}`;
---

<Base
  title="Blog"
  description="Writing on urban mobility, sustainable transportation, and city life — from an engineer turned mobility student."
>
  <div class="page blog-page">
    <div class="page-header">
      <div class="blog-header">
        <h1>Blog</h1>
        <a class="rss-link" href="/blog/rss.xml" aria-label="Subscribe via RSS">
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M6.18 15.64a2.18 2.18 0 0 1 2.18 2.18C8.36 19.01 7.38 20 6.18 20C4.98 20 4 19.01 4 17.82a2.18 2.18 0 0 1 2.18-2.18M4 4.44A15.56 15.56 0 0 1 19.56 20h-2.83A12.73 12.73 0 0 0 4 7.27V4.44m0 5.66a9.9 9.9 0 0 1 9.9 9.9h-2.83A7.07 7.07 0 0 0 4 12.93V10.1z" />
          </svg>
          <span>RSS</span>
        </a>
      </div>
      <p>Notes on urban mobility, city life, and figuring it out in public.</p>
    </div>

    {posts.length === 0 ? (
      <p class="post-empty">No posts yet. Check back soon.</p>
    ) : (
      <>
        <section aria-label="Blog posts">
          {posts.map((post) => <BlogPostEntry post={post} />)}
        </section>
        <p class="post-count">{postCountLabel}</p>
      </>
    )}

    <NewsletterSignup />

    <p class="blog-follow-note">
      Or follow by <a href="/blog/rss.xml">RSS</a> ·
      <a href="/api/contact">email me</a> to be added by hand
    </p>
  </div>
</Base>
