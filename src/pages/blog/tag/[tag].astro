---
import Base from '../../../layouts/Base.astro';
import { getAllTags, getPostsByTag, dateFormatter, isoDate, postReadingTime } from '../../../lib/blog.ts';

export async function getStaticPaths() {
  const tags = await getAllTags();
  return Promise.all(
    tags.map(async (tag) => ({
      params: { tag },
      props: { tag, posts: await getPostsByTag(tag) },
    })),
  );
}

const { tag, posts } = Astro.props;
---

<Base
  title={`Tag: ${tag}`}
  description={`Posts tagged "${tag}" on mjrossi.com.`}
  section="none"
  pageLabel="Blog"
>
  <div class="page blog-page">
    <div class="page-header">
      <h1>Tag: {tag}</h1>
      <p>{posts.length} {posts.length === 1 ? 'post' : 'posts'} tagged <em>{tag}</em>.</p>
      <p class="page-meta">
        <span><span class="page-meta-label">Back</span> <a href="/blog">All posts</a></span>
      </p>
    </div>

    <section aria-label={`Posts tagged ${tag}`}>
      {posts.map((post) => (
        <article class="post-entry">
          <div class="post-entry-meta">
            <time datetime={isoDate(post.data.pubDate)}>
              {dateFormatter.format(post.data.pubDate)}
            </time>
            <span class="meta-sep" aria-hidden="true">·</span>
            <span>{postReadingTime(post)}</span>
          </div>
          <h2 class="post-entry-title">
            <a href={`/blog/${post.id}/`}>{post.data.title}</a>
          </h2>
          <p class="post-entry-description">{post.data.description}</p>
          {post.data.tags.length > 0 && (
            <p class="post-entry-tags">
              {post.data.tags.map((t) => (
                <a href={`/blog/tag/${t}/`} class="tag-chip">{t}</a>
              ))}
            </p>
          )}
        </article>
      ))}
    </section>
  </div>
</Base>
