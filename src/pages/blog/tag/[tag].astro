---
import Base from '../../../layouts/Base.astro';
import BlogPostEntry from '../../../components/BlogPostEntry.astro';
import PageHeader from '../../../components/PageHeader.astro';
import { getAllTags, getPostsByTag } from '../../../lib/blog.ts';

const { tag } = Astro.params;
const tags = await getAllTags();

if (!tag || !tags.includes(tag)) {
  return new Response('Not Found', { status: 404 });
}

const posts = await getPostsByTag(tag);
---

<Base
  title={`Tag: ${tag}`}
  description={`Posts tagged "${tag}" on mjrossi.com.`}
>
  <div class="page blog-page">
    <PageHeader title={`Tag: ${tag}`}>
      <p>{posts.length} {posts.length === 1 ? 'post' : 'posts'} tagged <em>{tag}</em>.</p>
      <p class="page-meta">
        <span><span class="page-meta-label">Back</span> <a href="/blog">All posts</a></span>
      </p>
    </PageHeader>

    <section aria-label={`Posts tagged ${tag}`}>
      {posts.map((post) => <BlogPostEntry post={post} />)}
    </section>
  </div>
</Base>
