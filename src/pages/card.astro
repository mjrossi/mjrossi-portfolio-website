---
// The digital business card: two faces of one 85 × 55 card, shown alone
// (`bare` — no masthead, nav or footer) so it can be held up to someone's
// phone. Front: the masthead at card scale. Back: email, the site, a QR code
// back to this page, and the .vcf.
//
// The address is NOT on this page. "Email" goes through /api/contact like the
// icon row does; the address itself reaches the recipient only inside the
// .vcf (/api/vcard). Smoke asserts this HTML never contains it.
//
// The page says TAGLINE, because it re-renders on every request. Everything
// someone else holds onto says CARD_TAGLINE: the .vcf's TITLE, and the
// description a text-thread link preview keeps — hence CARD_DESCRIPTION below.
// The preview's title is the name alone (ogTitle), not the tab's "Card — …".
//
// Out of the sitemap (astro.config.mjs) and the nav, but indexable.
import Base from '../layouts/Base.astro';
import { TAGLINE, CARD_DESCRIPTION } from '../lib/identity.js';
import { QR_SIZE, QR_PATH } from '../lib/card-qr.js';
---

<Base title="Card" ogTitle="Matthew Rossi" description={CARD_DESCRIPTION} bare>
  <div class="card-sheet">

    <section class="card-face card-front" aria-label="Card, front">
      <p class="card-folio">
        <span>Lisbon, Portugal</span><span class="dot" aria-hidden="true">·</span><span>mjrossi.com</span>
      </p>
      <h1 class="card-name">Matthew <span class="surname">Rossi</span></h1>
      <div class="card-tagline-row">
        <span class="card-rule" aria-hidden="true"></span>
        <span class="card-tagline">{TAGLINE}</span>
        <span class="card-rule" aria-hidden="true"></span>
      </div>
    </section>

    <section class="card-face card-back" aria-label="Card, back">
      <ul class="card-contact">
        <li><a class="card-add" href="/api/vcard">Add to contacts</a></li>
        <li><a href="/api/contact">Email</a></li>
        <li><a href="/">mjrossi.com</a></li>
      </ul>
      <svg
        class="card-qr"
        viewBox={`0 0 ${QR_SIZE} ${QR_SIZE}`}
        role="img"
        aria-label="QR code linking to mjrossi.com/card"
        shape-rendering="crispEdges"
      >
        <rect class="card-qr-tile" width={QR_SIZE} height={QR_SIZE} />
        <path class="card-qr-ink" d={QR_PATH} />
      </svg>
    </section>

  </div>
</Base>

<style>
  /* Scoped to this route: Astro hoists a page's <style> into that page's own
     stylesheet, so none of this reaches any other route. Every colour is a
     token; the QR tile's two are Paper-only by design (see global.css). */

  :global(main.bare) {
    min-height: 100svh;
    display: grid;
    align-content: center;
  }

  .card-sheet {
    width: 100%;
    max-width: 60rem;
    margin: 0 auto;
    padding: clamp(1.5rem, 6vw, 4rem) var(--pad);
    display: grid;
    gap: clamp(1.5rem, 4vw, 2.5rem);
  }

  @media (min-width: 760px) {
    .card-sheet {
      grid-template-columns: 1fr 1fr;
    }
  }

  /* 85 × 55 mm, the European card. container-type makes `cqi` the face's own
     width for everything INSIDE it, so type scales with the card rather than
     the window. Not for the face's own padding or gap, though: there `cqi`
     looks past the face for a container, finds none, and falls back to the
     viewport — 7cqi of a 1280px window is 90px a side. Percentage padding
     resolves against the column, which is the face's width, so it is used
     here instead, and the spacing between children lives on the children. */
  .card-face {
    position: relative;
    aspect-ratio: 85 / 55;
    container-type: inline-size;
    padding: 6% 7%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-width: 0;
  }

  /* ── Front: the masthead band at card scale ───────── */

  .card-front {
    background: var(--accent-band);
    border: 1px solid var(--accent-band-border);
    margin-bottom: 4px;
  }

  /* Newsprint grain, as on .masthead::before. */
  .card-front::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: var(--grain-opacity);
    mix-blend-mode: var(--grain-blend);
    background-image: url("/noise.webp");
    background-size: 220px 220px;
  }

  /* The double rule: the face's own border, a gap, then a heavier line. */
  .card-front::after {
    content: '';
    position: absolute;
    left: -1px;
    right: -1px;
    bottom: -5px;
    height: 2px;
    background: var(--accent-band-border);
    pointer-events: none;
  }

  .card-front > * {
    position: relative;
    z-index: 1;
    margin: 0;
  }

  .card-front > * + * {
    margin-top: 4cqi;
  }

  .card-folio {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    font-family: var(--font-ui);
    font-size: clamp(0.656rem, 2.9cqi, 0.75rem);
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--accent-tagline);
  }

  .card-folio .dot {
    color: var(--accent-rule);
    margin: 0 0.6em;
  }

  /* The floor is the core folio size, 10.5px, and at that size the line needs
     a face 289px wide (measured) — about a 344px phone. Below it, flex-wrap
     alone strands the dot at the end of line one, so a narrow face stacks the
     two items and drops it. The query measures the face's CONTENT box, inside
     its 7% padding: 258px is a 300px face, which leaves room for font-
     rendering differences. A face that would just fit stacks instead, which
     costs nothing. */
  @container (max-width: 258px) {
    .card-folio {
      flex-direction: column;
      align-items: center;
    }

    .card-folio .dot {
      display: none;
    }
  }

  /* --accent-surname is display-only (≥24px). The clamp's floor is that rule,
     in px so it cannot drift with the root size; at a 320px viewport the face
     is ~280px wide and 12cqi is already ~34px. */
  .card-name {
    font-family: var(--font-serif);
    font-size: clamp(24px, 12cqi, 3.6rem);
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 0.95;
    text-align: center;
    color: var(--text);
    font-optical-sizing: auto;
    font-variation-settings: 'opsz' 144, 'SOFT' 30;
  }

  .card-name .surname {
    color: var(--accent-surname);
  }

  .card-tagline-row {
    display: flex;
    align-items: center;
    gap: 3cqi;
  }

  .card-rule {
    flex: 1;
    min-width: 1.25rem;
    height: 1px;
    background: var(--accent-rule);
  }

  .card-tagline {
    flex: 0 1 auto;
    max-width: 70cqi;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(0.75rem, 3.6cqi, 1rem);
    line-height: 1.3;
    text-align: center;
    text-wrap: balance;
    color: var(--accent-tagline);
  }

  /* ── Back: ruled, broadsheet-style ────────────────── */

  /* On a phone the back gives up the 85:55 shape: the links stack above a QR
     code as wide as the face. At card proportions on a 390px screen the code
     was ~144px — two or three centimetres, scanned from arm's length across a
     crowded room. The front keeps its proportions; it is the one people read.
     The links come first because the person who reads them is the one who
     scanned the code, on their own phone; the person holding the code up can
     scroll. From 760px the faces sit side by side and the back is a card
     again, links beside the code. */
  .card-back {
    background: var(--bg);
    border: 1px solid var(--rule-strong);
    aspect-ratio: auto;
    justify-content: flex-start;
  }

  .card-contact {
    flex: 1;
    min-width: 0;
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--rule-strong);
  }

  .card-contact li {
    padding: 3cqi 0;
    border-bottom: 1px solid var(--border);
  }

  .card-contact li:last-child {
    border-bottom-color: var(--rule-strong);
  }

  .card-contact a {
    font-family: var(--font-serif);
    font-size: clamp(0.875rem, 4.6cqi, 1.3rem);
    line-height: 1.15;
    color: var(--accent);
    text-decoration: none;
  }

  .card-contact a:hover {
    color: var(--accent-hover);
    text-decoration: underline;
  }

  /* The one action that matters, so the one button on the card: the site's
     existing primary button (Subscribe.astro's — --text fill, --bg type, 2px
     corners, --accent-hover on hover) at full width and a 44px tap height.
     Both pairs clear 4.5:1 in both themes; the focus ring is the global one. */
  .card-contact .card-add {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 0.55em 1em;
    border-radius: 2px;
    background: var(--text);
    color: var(--bg);
    font-family: var(--font-ui);
    font-size: clamp(0.875rem, 4.2cqi, 1.05rem);
    font-weight: 600;
    letter-spacing: 0.01em;
    transition: background 0.15s ease;
  }

  .card-contact .card-add:hover {
    background: var(--accent-hover);
    color: var(--bg);
    text-decoration: none;
  }

  /* The tile is the whole viewBox, the 4-module quiet zone included, and is
     Paper in both themes: dark modules on a light ground, always. On a phone
     it takes the face's full content width (~300px at 390, ~240px at 320);
     the cap only binds on a tablet in the stacked layout. */
  .card-qr {
    flex: none;
    width: 100%;
    max-width: 22rem;
    height: auto;
    margin: 6cqi auto 0;
    display: block;
  }

  .card-qr-tile {
    fill: var(--qr-tile);
  }

  .card-qr-ink {
    fill: var(--qr-ink);
  }

  @media (min-width: 760px) {
    .card-back {
      aspect-ratio: 85 / 55;
      flex-direction: row;
      align-items: center;
      justify-content: center;
    }

    /* About four fifths of the face's inner height. */
    .card-qr {
      width: 48cqi;
      max-width: none;
      margin: 0 0 0 5cqi;
    }
  }

  /* No motion. The back used to turn over into place on load, starting
     edge-on — so for its first 250ms, and for as long as a background tab
     held the animation paused, the face carrying the QR code was blank, and a
     quick screenshot kept as an offline fallback could catch it that way. The
     face that gets scanned does not wait on an animation. */
</style>
