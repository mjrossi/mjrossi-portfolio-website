---
// The digital business card, the scanner's view: two faces of one 85 × 55
// card, `bare`. Front: the masthead at card scale. Back: the .vcf, email, site.
//
// No QR code: a code pointing at the page they're on is useless, and it
// competed with "Add to contacts". It lives on /card/qr, the view held up.
//
// The address is NOT in this HTML (smoke asserts it): email goes via
// /api/contact, and the address itself (and the phone) only in the .vcf. The page says TAGLINE
// (it re-renders); what others keep says CARD_TAGLINE / CARD_DESCRIPTION.
// Out of the sitemap and nav, but indexable.
import Base from '../layouts/Base.astro';
import { TAGLINE, CARD_DESCRIPTION } from '../lib/identity.js';
---

<Base title="Card" ogTitle="Matthew Rossi" description={CARD_DESCRIPTION} bare>
  <div class="card-sheet">

    <section class="card-face card-front" aria-label="Card, front">
      <p class="card-folio">
        <span>Lisbon, Portugal</span><span class="dot" aria-hidden="true">·</span><span>mjrossi.com</span>
      </p>
      <h1 class="card-name">Matthew <span class="surname">Rossi</span></h1>
      <div class="card-tagline-row">
        <span class="card-rule" aria-hidden="true"></span>
        <span class="card-tagline">{TAGLINE}</span>
        <span class="card-rule" aria-hidden="true"></span>
      </div>
    </section>

    <section class="card-face card-back" aria-label="Card, back">
      <ul class="card-contact">
        <li><a class="card-add" href="/api/vcard"><span>Add to contacts</span><span class="card-go" aria-hidden="true">+</span></a></li>
        <li><a class="card-row" href="/api/contact"><span>Email</span><span class="card-go" aria-hidden="true">→</span></a></li>
        <li><a class="card-row" href="/"><span>mjrossi.com</span><span class="card-go" aria-hidden="true">→</span></a></li>
      </ul>
    </section>

  </div>
</Base>

<style>
  /* Scoped: Astro hoists this into this route's stylesheet only. */

  :global(main.bare) {
    min-height: 100vh; /* before svh: Safari < 15.4, Chrome < 108 */
    min-height: 100svh;
    display: grid;
    align-content: center;
  }

  .card-sheet {
    width: 100%;
    max-width: 60rem;
    margin: 0 auto;
    padding: clamp(1.5rem, 6vw, 4rem) var(--pad);
    display: grid;
    gap: clamp(1.5rem, 4vw, 2.5rem);
  }

  @media (min-width: 760px) {
    .card-sheet {
      grid-template-columns: 1fr 1fr;
    }
  }

  /* 85 × 55 mm. container-type makes `cqi` the face's width for its CHILDREN;
     the face's own padding uses %, because there `cqi` falls back to the
     viewport (7cqi of 1280px is 90px a side). */
  .card-face {
    position: relative;
    aspect-ratio: 85 / 55;
    container-type: inline-size;
    padding: 6% 7%;
    /* Sections get a 3rem margin from global.css; unset, it pushed the pair off centre. */
    margin: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-width: 0;
  }

  /* ── Front: the masthead band at card scale ───────── */

  .card-front {
    background: var(--accent-band);
    border: 1px solid var(--accent-band-border);
  }

  /* Newsprint grain, as on .masthead::before. */
  .card-front::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: var(--grain-opacity);
    mix-blend-mode: var(--grain-blend);
    background-image: url("/noise.webp");
    background-size: 220px 220px;
  }

  /* No double rule: under a card it reads as a stray second edge. */

  .card-front > * {
    position: relative;
    z-index: 1;
    margin: 0;
  }

  .card-front > * + * {
    margin-top: 4cqi;
  }

  .card-folio {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    font-family: var(--font-ui);
    font-size: clamp(0.656rem, 2.9cqi, 0.75rem);
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--accent-tagline);
  }

  .card-folio .dot {
    color: var(--accent-rule);
    margin: 0 0.6em;
  }

  /* At the 10.5px folio floor the line needs a 289px face (~a 344px phone).
     Below that, stack the two items and drop the dot. 258px is the CONTENT
     box of a 300px face, with margin for font-rendering differences. */
  @container (max-width: 258px) {
    .card-folio {
      flex-direction: column;
      align-items: center;
    }

    .card-folio .dot {
      display: none;
    }
  }

  /* --accent-surname is ≥24px only; the floor is that rule, in px. */
  .card-name {
    font-family: var(--font-serif);
    font-size: clamp(24px, 12cqi, 3.6rem);
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 0.95;
    text-align: center;
    color: var(--text);
    font-optical-sizing: auto;
    font-variation-settings: 'opsz' 144, 'SOFT' 30;
  }

  .card-name .surname {
    color: var(--accent-surname);
  }

  .card-tagline-row {
    display: flex;
    align-items: center;
    gap: 3cqi;
  }

  .card-rule {
    flex: 1;
    min-width: 1.25rem;
    height: 1px;
    background: var(--accent-rule);
  }

  .card-tagline {
    flex: 0 1 auto;
    max-width: 70cqi;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(0.75rem, 3.6cqi, 1rem);
    line-height: 1.3;
    text-align: center;
    text-wrap: balance;
    color: var(--accent-tagline);
  }

  /* ── Back: ruled, broadsheet-style ────────────────── */

  /* An 85:55 face from 320px up: the three rows take 141px of a ~145px content
     box. Aspect-ratio lets a wider fallback font grow it rather than clip.
     The frame is the front's --accent-band-border: one card, one edge. */
  .card-back {
    background: var(--bg);
    border: 1px solid var(--accent-band-border);
  }

  /* Ruled BETWEEN rows only; the frame draws the edge. */
  .card-contact {
    min-width: 0;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .card-contact li + li {
    border-top: 1px solid var(--border);
  }

  /* The button row isn't ruled: room below before the first hairline. */
  .card-contact li:first-child {
    padding-bottom: 3cqi;
  }

  .card-contact a {
    font-family: var(--font-serif);
    font-size: clamp(0.875rem, 4.6cqi, 1.3rem);
    line-height: 1.15;
    color: var(--accent);
    text-decoration: none;
  }

  /* The whole row is the link (the word alone was a ~16px target). 44px
     floor; the → is aria-hidden. */
  .card-contact .card-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1em;
    min-height: 44px;
    padding: 3cqi 0;
  }

  /* No transition, so the arrow changes with the label. */
  .card-go {
    font-family: var(--font-ui);
    color: var(--accent-rule);
  }

  /* Hover only with a pointer: on a phone :hover sticks to the last row tapped. */
  .card-contact .card-row:focus-visible {
    color: var(--accent-hover);
  }

  .card-contact .card-row:focus-visible > :first-child {
    text-decoration: underline;
  }

  .card-contact .card-row:focus-visible .card-go {
    color: var(--accent-hover);
  }

  @media (hover: hover) {
    .card-contact .card-row:hover {
      color: var(--accent-hover);
    }

    .card-contact .card-row:hover > :first-child {
      text-decoration: underline;
    }

    .card-contact .card-row:hover .card-go {
      color: var(--accent-hover);
    }
  }

  /* The card's one button, in its own material: the front's band fill and
     edge, the list's serif at its size, in --text (the wordmark's pair, 4.5:1
     in both themes). Subscribe's --text slab was the heaviest thing on screen.
     Full width, 44px tall. */
  /* Left-aligned with a + at the right, so it reads as the list's first row. */
  .card-contact .card-add {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5em;
    min-height: 44px;
    padding: 0.5em 1em;
    border: 1px solid var(--accent-band-border);
    border-radius: 2px;
    background: var(--accent-band);
    color: var(--text);
    font-weight: 600;
    transition: border-color 0.15s ease;
  }

  .card-add .card-go {
    color: var(--accent);
  }

  .card-contact .card-add:focus-visible {
    border-color: var(--accent);
  }

  @media (hover: hover) {
    .card-contact .card-add:hover {
      border-color: var(--accent);
      color: var(--text);
    }
  }

  /* No motion: the old flip-in left the back blank in background tabs and screenshots. */
</style>
