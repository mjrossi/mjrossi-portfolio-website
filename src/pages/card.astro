---
// The digital business card: two faces of one 85 × 55 card, shown alone
// (`bare` — no masthead, nav or footer) so it can be held up to someone's
// phone. Front: the masthead at card scale. Back: the .vcf, email, the site.
//
// No QR code. This is the page the scanner LANDS on, and a code pointing at the
// page they are already reading is useless to them — and, as the largest thing
// on the screen, it competed with "Add to contacts", the one thing they came
// for. The code lives on /card/qr, the presenter's view, which is the page that
// gets held up.
//
// The address is NOT on this page. "Email" goes through /api/contact like the
// icon row does; the address itself reaches the recipient only inside the
// .vcf (/api/vcard). Smoke asserts this HTML never contains it.
//
// The page says TAGLINE, because it re-renders on every request. Everything
// someone else holds onto says CARD_TAGLINE: the .vcf's TITLE, and the
// description a text-thread link preview keeps — hence CARD_DESCRIPTION below.
// The preview's title is the name alone (ogTitle), not the tab's "Card — …".
//
// Out of the sitemap (astro.config.mjs) and the nav, but indexable.
import Base from '../layouts/Base.astro';
import { TAGLINE, CARD_DESCRIPTION } from '../lib/identity.js';
---

<Base title="Card" ogTitle="Matthew Rossi" description={CARD_DESCRIPTION} bare>
  <div class="card-sheet">

    <section class="card-face card-front" aria-label="Card, front">
      <p class="card-folio">
        <span>Lisbon, Portugal</span><span class="dot" aria-hidden="true">·</span><span>mjrossi.com</span>
      </p>
      <h1 class="card-name">Matthew <span class="surname">Rossi</span></h1>
      <div class="card-tagline-row">
        <span class="card-rule" aria-hidden="true"></span>
        <span class="card-tagline">{TAGLINE}</span>
        <span class="card-rule" aria-hidden="true"></span>
      </div>
    </section>

    <section class="card-face card-back" aria-label="Card, back">
      <ul class="card-contact">
        <li><a class="card-add" href="/api/vcard">Add to contacts</a></li>
        <li><a href="/api/contact">Email</a></li>
        <li><a href="/">mjrossi.com</a></li>
      </ul>
    </section>

  </div>
</Base>

<style>
  /* Scoped to this route: Astro hoists a page's <style> into that page's own
     stylesheet, so none of this reaches any other route. Every colour is a
     token. */

  :global(main.bare) {
    min-height: 100vh; /* before svh: Safari < 15.4, Chrome < 108 */
    min-height: 100svh;
    display: grid;
    align-content: center;
  }

  .card-sheet {
    width: 100%;
    max-width: 60rem;
    margin: 0 auto;
    padding: clamp(1.5rem, 6vw, 4rem) var(--pad);
    display: grid;
    gap: clamp(1.5rem, 4vw, 2.5rem);
  }

  @media (min-width: 760px) {
    .card-sheet {
      grid-template-columns: 1fr 1fr;
    }
  }

  /* 85 × 55 mm, the European card. container-type makes `cqi` the face's own
     width for everything INSIDE it, so type scales with the card rather than
     the window. Not for the face's own padding or gap, though: there `cqi`
     looks past the face for a container, finds none, and falls back to the
     viewport — 7cqi of a 1280px window is 90px a side. Percentage padding
     resolves against the column, which is the face's width, so it is used
     here instead, and the spacing between children lives on the children. */
  .card-face {
    position: relative;
    aspect-ratio: 85 / 55;
    container-type: inline-size;
    padding: 6% 7%;
    /* Both faces are <section>s, which global.css gives a 3rem bottom margin.
       The front's old 4px (room for its double rule) overrode that by
       accident; the back kept it, and sat the pair 24px above centre. */
    margin: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-width: 0;
  }

  /* ── Front: the masthead band at card scale ───────── */

  .card-front {
    background: var(--accent-band);
    border: 1px solid var(--accent-band-border);
  }

  /* Newsprint grain, as on .masthead::before. */
  .card-front::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: var(--grain-opacity);
    mix-blend-mode: var(--grain-blend);
    background-image: url("/noise.webp");
    background-size: 220px 220px;
  }

  /* No double rule. The masthead's closes a band that spans the page; under
     a card face it read as a stray second edge, and hung the front 5px below
     the back where the two sit side by side. A card has one edge. */

  .card-front > * {
    position: relative;
    z-index: 1;
    margin: 0;
  }

  .card-front > * + * {
    margin-top: 4cqi;
  }

  .card-folio {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    font-family: var(--font-ui);
    font-size: clamp(0.656rem, 2.9cqi, 0.75rem);
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--accent-tagline);
  }

  .card-folio .dot {
    color: var(--accent-rule);
    margin: 0 0.6em;
  }

  /* The floor is the core folio size, 10.5px, and at that size the line needs
     a face 289px wide (measured) — about a 344px phone. Below it, flex-wrap
     alone strands the dot at the end of line one, so a narrow face stacks the
     two items and drops it. The query measures the face's CONTENT box, inside
     its 7% padding: 258px is a 300px face, which leaves room for font-
     rendering differences. A face that would just fit stacks instead, which
     costs nothing. */
  @container (max-width: 258px) {
    .card-folio {
      flex-direction: column;
      align-items: center;
    }

    .card-folio .dot {
      display: none;
    }
  }

  /* --accent-surname is display-only (≥24px). The clamp's floor is that rule,
     in px so it cannot drift with the root size; at a 320px viewport the face
     is ~280px wide and 12cqi is already ~34px. */
  .card-name {
    font-family: var(--font-serif);
    font-size: clamp(24px, 12cqi, 3.6rem);
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 0.95;
    text-align: center;
    color: var(--text);
    font-optical-sizing: auto;
    font-variation-settings: 'opsz' 144, 'SOFT' 30;
  }

  .card-name .surname {
    color: var(--accent-surname);
  }

  .card-tagline-row {
    display: flex;
    align-items: center;
    gap: 3cqi;
  }

  .card-rule {
    flex: 1;
    min-width: 1.25rem;
    height: 1px;
    background: var(--accent-rule);
  }

  .card-tagline {
    flex: 0 1 auto;
    max-width: 70cqi;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(0.75rem, 3.6cqi, 1rem);
    line-height: 1.3;
    text-align: center;
    text-wrap: balance;
    color: var(--accent-tagline);
  }

  /* ── Back: ruled, broadsheet-style ────────────────── */

  /* A card at every width again: without the QR code the three rows fit the
     85:55 face from 320px up — measured, 134px of a ~145px content box at 320,
     142 of 182 at 390. Aspect-ratio lets a face grow rather than clip, so a
     wider fallback font costs height, not content.

     One card, one edge: the frame is the front's --accent-band-border. It
     was --rule-strong, which in Paper gave the back a visibly harder edge
     than the front it is the other side of. */
  .card-back {
    background: var(--bg);
    border: 1px solid var(--accent-band-border);
  }

  /* Ruled BETWEEN rows only. The list used to carry its own top and bottom
     rules as well, inside the face's frame — two lines doing the frame's job,
     and the top one sat a few px over the button with nothing to separate. */
  .card-contact {
    min-width: 0;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .card-contact li {
    padding: 3cqi 0;
  }

  .card-contact li + li {
    border-top: 1px solid var(--border);
  }

  /* The button row is not a ruled row: no rule hugging it from above, and
     room below before the first hairline. */
  .card-contact li:first-child {
    padding-top: 0;
    padding-bottom: 4.5cqi;
  }

  .card-contact li:last-child {
    padding-bottom: 0;
  }

  .card-contact a {
    font-family: var(--font-serif);
    font-size: clamp(0.875rem, 4.6cqi, 1.3rem);
    line-height: 1.15;
    color: var(--accent);
    text-decoration: none;
  }

  .card-contact a:hover {
    color: var(--accent-hover);
    text-decoration: underline;
  }

  /* The one action that matters, so the one button on the card — but in the
     card's own material rather than the site's primary button. A --text slab
     (Subscribe's) was the heaviest thing on the screen, outweighing the name,
     and in Night the brightest. This is the front's band: --accent-band fill,
     --accent-band-border edge, the list's own serif at the list's own size, in
     --text so it still out-ranks the accent links beside it. Full width at a
     44px tap height. --text on --accent-band is the wordmark's own pair, so it
     clears 4.5:1 in both themes; the focus ring is the global one. */
  .card-contact .card-add {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5em;
    min-height: 44px;
    padding: 0.5em 1em;
    border: 1px solid var(--accent-band-border);
    border-radius: 2px;
    background: var(--accent-band);
    color: var(--text);
    font-weight: 600;
    transition: border-color 0.15s ease;
  }

  .card-contact .card-add:hover {
    border-color: var(--accent);
    color: var(--text);
  }

  /* No motion. The back used to turn over into place on load, starting
     edge-on — so for its first 250ms, and for as long as a background tab
     held the animation paused, the face was blank, and a quick screenshot
     could catch it that way. A card does not wait on an animation. */
</style>
