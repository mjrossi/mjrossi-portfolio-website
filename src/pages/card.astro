---
// The digital business card: two faces of one 85 × 55 card, shown alone
// (`bare` — no masthead, nav or footer) so it can be held up to someone's
// phone. Front: the masthead at card scale. Back: email, the site, a QR code
// back to this page, and the .vcf.
//
// The address is NOT on this page. "Email" goes through /api/contact like the
// icon row does; the address itself reaches the recipient only inside the
// .vcf (/api/vcard). Smoke asserts this HTML never contains it.
//
// The page says TAGLINE, because it re-renders on every request. Everything
// someone else holds onto says CARD_TAGLINE: the .vcf's NOTE, and the
// description a text-thread link preview keeps — hence CARD_DESCRIPTION below.
//
// Out of the sitemap (astro.config.mjs) and the nav, but indexable.
import Base from '../layouts/Base.astro';
import { TAGLINE, CARD_DESCRIPTION } from '../lib/identity.js';
import { QR_SIZE, QR_PATH } from '../lib/card-qr.js';
---

<Base title="Card" description={CARD_DESCRIPTION} bare>
  <div class="card-sheet">

    <section class="card-face card-front" aria-label="Card, front">
      <p class="card-folio">
        <span>Lisbon, Portugal</span><span class="dot" aria-hidden="true">·</span><span>mjrossi.com</span>
      </p>
      <h1 class="card-name">Matthew <span class="surname">Rossi</span></h1>
      <div class="card-tagline-row">
        <span class="card-rule" aria-hidden="true"></span>
        <span class="card-tagline">{TAGLINE}</span>
        <span class="card-rule" aria-hidden="true"></span>
      </div>
    </section>

    <section class="card-face card-back" aria-label="Card, back">
      <ul class="card-contact">
        <li><a href="/api/contact">Email</a></li>
        <li><a href="/">mjrossi.com</a></li>
        <li><a href="/api/vcard">Add to contacts</a></li>
      </ul>
      <svg
        class="card-qr"
        viewBox={`0 0 ${QR_SIZE} ${QR_SIZE}`}
        role="img"
        aria-label="QR code linking to mjrossi.com/card"
        shape-rendering="crispEdges"
      >
        <rect class="card-qr-tile" width={QR_SIZE} height={QR_SIZE} />
        <path class="card-qr-ink" d={QR_PATH} />
      </svg>
    </section>

  </div>
</Base>

<style>
  /* Scoped to this route: Astro hoists a page's <style> into that page's own
     stylesheet, so none of this reaches any other route. Every colour is a
     token; the QR tile's two are Paper-only by design (see global.css). */

  :global(main.bare) {
    min-height: 100svh;
    display: grid;
    align-content: center;
  }

  .card-sheet {
    width: 100%;
    max-width: 60rem;
    margin: 0 auto;
    padding: clamp(1.5rem, 6vw, 4rem) var(--pad);
    display: grid;
    gap: clamp(1.5rem, 4vw, 2.5rem);
  }

  @media (min-width: 760px) {
    .card-sheet {
      grid-template-columns: 1fr 1fr;
    }
  }

  /* 85 × 55 mm, the European card. container-type makes `cqi` the face's own
     width for everything INSIDE it, so type scales with the card rather than
     the window. Not for the face's own padding or gap, though: there `cqi`
     looks past the face for a container, finds none, and falls back to the
     viewport — 7cqi of a 1280px window is 90px a side. Percentage padding
     resolves against the column, which is the face's width, so it is used
     here instead, and the spacing between children lives on the children. */
  .card-face {
    position: relative;
    aspect-ratio: 85 / 55;
    container-type: inline-size;
    padding: 6% 7%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-width: 0;
  }

  /* ── Front: the masthead band at card scale ───────── */

  .card-front {
    background: var(--accent-band);
    border: 1px solid var(--accent-band-border);
    margin-bottom: 4px;
  }

  /* Newsprint grain, as on .masthead::before. */
  .card-front::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: var(--grain-opacity);
    mix-blend-mode: var(--grain-blend);
    background-image: url("/noise.webp");
    background-size: 220px 220px;
  }

  /* The double rule: the face's own border, a gap, then a heavier line. */
  .card-front::after {
    content: '';
    position: absolute;
    left: -1px;
    right: -1px;
    bottom: -5px;
    height: 2px;
    background: var(--accent-band-border);
    pointer-events: none;
  }

  .card-front > * {
    position: relative;
    z-index: 1;
    margin: 0;
  }

  .card-front > * + * {
    margin-top: 4cqi;
  }

  .card-folio {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    font-family: var(--font-ui);
    font-size: clamp(0.656rem, 2.9cqi, 0.75rem);
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--accent-tagline);
  }

  .card-folio .dot {
    color: var(--accent-rule);
    margin: 0 0.6em;
  }

  /* The floor is the core folio size, 10.5px, and at that size the line needs
     a face 289px wide (measured) — about a 344px phone. Below it, flex-wrap
     alone strands the dot at the end of line one, so a narrow face stacks the
     two items and drops it. The query measures the face's CONTENT box, inside
     its 7% padding: 258px is a 300px face, which leaves room for font-
     rendering differences. A face that would just fit stacks instead, which
     costs nothing. */
  @container (max-width: 258px) {
    .card-folio {
      flex-direction: column;
      align-items: center;
    }

    .card-folio .dot {
      display: none;
    }
  }

  /* --accent-surname is display-only (≥24px). The clamp's floor is that rule,
     in px so it cannot drift with the root size; at a 320px viewport the face
     is ~280px wide and 12cqi is already ~34px. */
  .card-name {
    font-family: var(--font-serif);
    font-size: clamp(24px, 12cqi, 3.6rem);
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 0.95;
    text-align: center;
    color: var(--text);
    font-optical-sizing: auto;
    font-variation-settings: 'opsz' 144, 'SOFT' 30;
  }

  .card-name .surname {
    color: var(--accent-surname);
  }

  .card-tagline-row {
    display: flex;
    align-items: center;
    gap: 3cqi;
  }

  .card-rule {
    flex: 1;
    min-width: 1.25rem;
    height: 1px;
    background: var(--accent-rule);
  }

  .card-tagline {
    flex: 0 1 auto;
    max-width: 70cqi;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(0.75rem, 3.6cqi, 1rem);
    line-height: 1.3;
    text-align: center;
    text-wrap: balance;
    color: var(--accent-tagline);
  }

  /* ── Back: ruled, broadsheet-style ────────────────── */

  .card-back {
    background: var(--bg);
    border: 1px solid var(--rule-strong);
    flex-direction: row;
    align-items: center;
  }

  .card-contact {
    flex: 1;
    min-width: 0;
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--rule-strong);
  }

  .card-contact li {
    padding: 3cqi 0;
    border-bottom: 1px solid var(--border);
  }

  .card-contact li:last-child {
    border-bottom-color: var(--rule-strong);
  }

  .card-contact a {
    font-family: var(--font-serif);
    font-size: clamp(0.875rem, 4.6cqi, 1.3rem);
    line-height: 1.15;
    color: var(--accent);
    text-decoration: none;
  }

  .card-contact a:hover {
    color: var(--accent-hover);
    text-decoration: underline;
  }

  /* As large as the face allows — about four fifths of its inner height —
     because this is the part held up to another camera; at a 320px viewport it
     is still only ~115px. The tile is the whole viewBox, the 4-module quiet
     zone included, and is Paper in both themes: dark modules on a light
     ground, always. */
  .card-qr {
    flex: none;
    width: 48cqi;
    margin-left: 5cqi;
    height: auto;
    display: block;
  }

  .card-qr-tile {
    fill: var(--qr-tile);
  }

  .card-qr-ink {
    fill: var(--qr-ink);
  }

  /* ── Motion: the back turns over, once ────────────── */

  /* The second half of a flip: the back starts edge-on and turns flat, so it
     reads as a card turned over without either face ever being hidden behind
     a tap — the back carries the QR code, which is what gets held up. Once, on
     load, CSS only; under reduced motion there is none at all, the same
     pattern as the masthead's drawRule in global.css. */
  @media (prefers-reduced-motion: no-preference) {
    .card-back {
      animation: cardTurn 650ms cubic-bezier(0.2, 0.7, 0.2, 1) 250ms both;
    }

    @keyframes cardTurn {
      from { transform: perspective(1200px) rotateY(-90deg); }
      to   { transform: perspective(1200px) rotateY(0); }
    }
  }
</style>
