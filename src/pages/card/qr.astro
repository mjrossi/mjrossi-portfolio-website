---
// The presenter's view of /card: the wordmark over a QR code, held up to
// someone else's phone. Nothing else — anything they want is on /card, which
// the code points at, never here. Split from /card because the presenter needs
// the code as large as the screen allows with no scroll (with /card's links
// above it, it sat under Safari's toolbars).
//
// The code is committed (src/lib/card-qr.js); printed cards carry the URL.
// bare, out of the sitemap and nav, and noindex.
import Base from '../../layouts/Base.astro';
import { CARD_DESCRIPTION } from '../../lib/identity.js';
import { QR_SIZE, QR_PATH } from '../../lib/card-qr.js';
---

<Base title="QR" ogTitle="Matthew Rossi" description={CARD_DESCRIPTION} noindex bare>
  <div class="qr-sheet">
    <h1 class="qr-name">Matthew <span class="surname">Rossi</span></h1>
    <svg
      class="card-qr"
      viewBox={`0 0 ${QR_SIZE} ${QR_SIZE}`}
      role="img"
      aria-label="QR code linking to mjrossi.com/card"
      shape-rendering="crispEdges"
    >
      <rect class="card-qr-tile" width={QR_SIZE} height={QR_SIZE} />
      <path class="card-qr-ink" d={QR_PATH} />
    </svg>
  </div>
</Base>

<style>
  /* Scoped. The QR tile's two colours are Paper in both themes (see global.css). */

  :global(main.bare) {
    min-height: 100vh; /* before svh: Safari < 15.4, Chrome < 108 */
    min-height: 100svh;
    display: grid;
    align-content: center;
  }

  .qr-sheet {
    width: 100%;
    max-width: 30rem;
    margin: 0 auto;
    padding: 1.25rem var(--pad);
    display: grid;
    justify-items: center;
    gap: 1.25rem;
  }

  /* --accent-surname is ≥24px only; the floor is that rule, in px. */
  .qr-name {
    margin: 0;
    font-family: var(--font-serif);
    font-size: clamp(28px, 9vw, 2.75rem);
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 0.95;
    text-align: center;
    color: var(--text);
    font-optical-sizing: auto;
    font-variation-settings: 'opsz' 144, 'SOFT' 30;
  }

  .qr-name .surname {
    color: var(--accent-surname);
  }

  /* Full content width, never taller than the SMALL viewport (svh: toolbars
     showing), so the code is whole on screen in both orientations. The tile
     is the whole viewBox, quiet zone included. */
  .card-qr {
    display: block;
    width: min(100%, 100vh - 9rem); /* drops whole without svh — keep a width */
    width: min(100%, 100svh - 9rem);
    height: auto;
  }

  .card-qr-tile {
    fill: var(--qr-tile);
  }

  .card-qr-ink {
    fill: var(--qr-ink);
  }
</style>
