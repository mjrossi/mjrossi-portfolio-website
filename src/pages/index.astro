---
import Base from '../layouts/Base.astro';
import { getLatestPosts, dateFormatter, isoDate, postReadingTime } from '../lib/blog.ts';
import { isPublished } from '../lib/schedule.js';
import { nowUpdatedLabel } from '../lib/now.js';

// "From the Lexicon" (finding 4.3): the periodical's name was doing no work
// outside /blog. This is a pointer at the archive, not a second index.
//
// getLatestPosts, not posts.slice(0, 2): on a *.workers.dev preview host
// scheduled posts are visible, and the smoke fixture is dated 2099, so the
// plain newest-first pick featured "Scheduled-post fixture (not a real post)"
// on every preview deploy.
//
// TWO entries, not one: the latest issue and the one before it is a better
// pointer at a periodical than a single headline. (It was first doubled because
// one entry left a 512px void under the old full-width grid; in the rail it
// is simply the right length.)
const latest = await getLatestPosts(2, { showScheduled: Astro.locals.showScheduled });
---

<Base title="Matthew Rossi">

  <div class="spread">
    <div class="col-about">
      <span class="section-label">About</span>
      <p class="dropcap">I grew up outside Detroit — a place built almost entirely around the car. When the car wouldn't start, you weren't going to work, or to the grocery store, or to that appointment. That kind of missing option stuck with me long before I had words for it.</p>
      <p>At twenty-three I moved to Chicago and sold my car, and it felt more like freedom than the car ever had. I spent the next thirteen years as a software engineer — payments, banking, cloud infrastructure — while the way cities move people went from a weekend interest to the lens I see everything through.</p>
      <p>Now I'm making it my primary focus.</p>
    </div>

    <aside class="rail" aria-label="Now and latest writing">
      <section class="rail-block col-now" aria-labelledby="now-label">
        <span class="section-label" id="now-label">Now</span>
        <span class="section-updated">{nowUpdatedLabel()}</span>
        <img
          src="/profile-avatar.webp"
          alt="Matthew Rossi"
          class="avatar"
          width="64"
          height="64"
          loading="lazy"
          decoding="async"
        />
        <p>I live in Lisbon, and since September I've been a student again: the <strong>EIT Urban Mobility master's (SUMT)</strong>, a two-year double degree — this year at Técnico Lisboa, next year at UPC BarcelonaTech in Barcelona.</p>
      </section>

      {latest.length > 0 && (
        <section class="rail-block amber" aria-labelledby="lexicon-teaser-label">
          <div class="lexicon-teaser">
            <span class="section-label" id="lexicon-teaser-label">From the Lexicon</span>
            {latest.map((post) => (
              <article class="lexicon-teaser-item">
                <h2 class="lexicon-teaser-title">
                  <a href={`/blog/${post.id}/`}>{post.data.title}</a>
                </h2>
                <p class="lexicon-teaser-meta">
                  {/* Only reachable where scheduled posts are visible at all — a
                      preview host or `astro dev` — and it is what says a featured
                      post isn't live yet. Keyed off isPublished, like every other
                      badge. */}
                  {!isPublished(post.data.pubDate) && <span class="post-scheduled">Scheduled</span>}
                  <time datetime={isoDate(post.data.pubDate)}>{dateFormatter.format(post.data.pubDate)}</time>
                  <span class="meta-sep" aria-hidden="true">·</span>
                  <span>{postReadingTime(post)}</span>
                </p>
                <p class="lexicon-teaser-excerpt">{post.data.description}</p>
              </article>
            ))}
            <a class="lexicon-teaser-more" href="/blog">More issues →</a>
          </div>
        </section>
      )}
    </aside>
  </div>

</Base>
