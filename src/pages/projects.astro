---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
---

<Base
  title="Projects"
  crumbs={[{ label: 'Front', href: '/' }, { label: 'Projects' }]}
  description="Things Matthew Rossi has built — open-source tools for transit and safe-streets advocacy."
>

  <div class="page">
  <PageHeader
    title="Projects"
    description="Tools I've built for the people already doing the work — organizers, advocates and anyone trying to make their own city better."
  />

  <section aria-label="Projects">

    <div class="entry">
      <div class="entry-header">
        <div class="entry-meta">
          <span class="company">Urbanist Atlas</span>
          <span class="role">Open-source web app · Go + React on Cloudflare and Fly.io</span>
        </div>
        <span class="date">2026–</span>
      </div>
      <p>A directory of transit and safe-streets advocacy groups across the US and Canada. Type in a postal code and it finds the groups working where you live, from your city's bike coalition to the regional transit campaign — or browse by metro, city or state. The data is open (ODbL), and anyone can suggest a group; each submission arrives as a GitHub pull request for review.</p>
      <p class="entry-links">
        <a href="https://urbanistatlas.com">urbanistatlas.com</a>
        · <a href="https://github.com/mjrossi/urbanist-atlas">Source on GitHub</a>
        · <a href="/blog/introducing-the-urbanist-atlas/">Read the launch post →</a>
      </p>
    </div>

  </section>

  </div>

</Base>
