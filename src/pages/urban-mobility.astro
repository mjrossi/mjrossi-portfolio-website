import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
---

<Base title="Urban Mobility" crumbs={[{ label: 'Front', href: '/' }, { label: 'Urban Mobility' }]} description="Matthew Rossi's engagement with urban mobility, transit advocacy, and civic technology.">

  <div class="page">
  <PageHeader title="Urban Mobility" description="How I got here: the groups I've organized with, the tools I've built, and what I keep reading about." />

  <section aria-labelledby="building-heading">
    <h2 id="building-heading">Building and Writing</h2>
    <p>I built and maintain <a href="/projects">Urbanist Atlas</a>, an open directory of transit and safe-streets advocacy groups across the US and Canada — code, data and documentation all under open licenses.</p>
    <p>I write <a href="/blog">The Urbanist Lexicon</a> about what I'm reading, what I notice in the cities I live in, and what I get wrong along the way.</p>
  </section>

  <section aria-labelledby="civic-tech-heading">
    <h2 id="civic-tech-heading">Civic Technology</h2>
    <p>In Chicago I started attending <a href="https://chihacknight.org" target="_blank" rel="noopener noreferrer">ChiHackNight</a>, a weekly meetup of people using technology to make the city better. My project there was a small Ruby library for the CTA's real-time customer alerts API. It taught me as much about how a transit agency makes decisions as about data formats: the XML payloads and hand-updated GTFS feeds showed what it prioritized, and how long old decisions stick around.</p>
  </section>

  <section aria-labelledby="advocacy-heading">
    <h2 id="advocacy-heading">Advocacy</h2>
    <p>After moving to New York in 2019 I got involved with <a href="https://www.ridersalliance.org" target="_blank" rel="noopener noreferrer">Riders Alliance</a> and <a href="https://www.transalt.org" target="_blank" rel="noopener noreferrer">Transportation Alternatives</a> — going to meetings, hearing from advocates and politicians, and learning how change in this space actually gets made.</p>
  </section>

  <section aria-labelledby="interests-heading">
    <h2 id="interests-heading">Research Interests</h2>
    <p>Transit-oriented development: how land use, housing and transit connect, and what makes it work in practice rather than on paper. And climate adaptation — how policy can make a whole transport system resilient instead of patching it piece by piece.</p>
  </section>

  </div>

</Base>
