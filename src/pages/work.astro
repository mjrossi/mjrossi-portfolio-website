---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
---

<Base title="Work" description="Matthew Rossi's work history — thirteen years in software engineering across Heroku, Capital One, Braintree, Clarity Consulting, and Ford Motor Company.">

  <div class="page">
  <PageHeader
    title="Work"
    description="Thirteen years across payments, financial services, and cloud infrastructure — building large-scale, high-reliability systems in regulated, multi-stakeholder environments. Before that, automotive enterprise IT and open-source licensing."
  >
    <p class="page-meta">
      <span><span class="page-meta-label">Tools</span> Go · Ruby · JavaScript · Python · C# · SQL</span>
      <a class="page-meta-action" href="/resume.pdf" download aria-label="Download resume (PDF)">
        <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true" focusable="false">
          <path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" d="M12 4v12m0 0-5-5m5 5 5-5M4 20h16"/>
        </svg>
        Resume
      </a>
    </p>
  </PageHeader>

  <section aria-label="Work history">

    <div class="entry">
      <div class="entry-header">
        <div class="entry-meta">
          <span class="company">Heroku (Salesforce)</span>
          <span class="role">Senior Software Engineer</span>
        </div>
        <span class="date">Jun 2021–May 2026</span>
      </div>
      <p>Built Heroku's credential and authorization management system. Designed the service layer for a new data synchronization platform. Drove improvements to on-call processes and operational reliability.</p>
    </div>

    <div class="entry">
      <div class="entry-header">
        <div class="entry-meta">
          <span class="company">Capital One</span>
          <span class="role">Senior Software Engineer</span>
        </div>
        <span class="date">Apr 2019–Jun 2021</span>
      </div>
      <p>Built an internal underwriting and portfolio-management system for Commercial Banking. Worked across product, business, and engineering teams in a heavily regulated environment.</p>
    </div>

    <div class="entry">
      <div class="entry-header">
        <div class="entry-meta">
          <span class="company">Braintree</span>
          <span class="role">Software Engineer</span>
        </div>
        <span class="date">Apr 2016–Mar 2019</span>
      </div>
      <p>Shipped payment processing features. Organized an internal engineering conference (~200 attendees). Mentored a cohort of software development apprentices.</p>
    </div>

    <div class="entry">
      <div class="entry-header">
        <div class="entry-meta">
          <span class="company">Clarity Consulting</span>
          <span class="role">Product Development Engineer</span>
        </div>
        <span class="date">Jul 2013–Mar 2016</span>
      </div>
      <p>Developed new features for Clarity Connect, a contact-center product built on Microsoft Skype for Business.</p>
    </div>

    <div class="entry">
      <div class="entry-header">
        <div class="entry-meta">
          <span class="company">Ford Motor Company</span>
          <span class="role">Open Source Coordinator&nbsp;(2012–2013) · Software Engineering Intern&nbsp;(2010,&nbsp;2011)</span>
        </div>
        <span class="date">2010–2013</span>
      </div>
      <p>The engineering voice on a team of attorneys handling IT contracts and software licensing. Earlier, summer internships in Windows Server engineering and internal tooling.</p>
    </div>

  </section>

  </div>

</Base>
