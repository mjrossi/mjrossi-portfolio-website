{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mjrossi-portfolio-website",
  "compatibility_date": "2026-04-17",

  // Disable the Worker's own `<name>.<subdomain>.workers.dev` alias. It is on
  // by default and serves PRODUCTION on a hostname derivable from this repo,
  // which `isPreviewHost` would otherwise treat as a preview and hand every
  // scheduled draft to — RSS included. src/lib/preview.js excludes the alias
  // in code as well; this is defence in depth, not a substitute.
  "workers_dev": false,

  // Per-branch preview URLs (`<alias>-<name>.<subdomain>.workers.dev`) are a
  // SEPARATE setting, and this must stay explicit. `preview_urls` defaults to
  // false in the config schema, and when it is absent from this file wrangler
  // resolves it from server-side state at deploy time — it warns that "your
  // 'preview_urls' setting is not in your Wrangler file" and then tracks the
  // workers.dev route status, which the line above just turned off. Leaving it
  // implicit therefore risks a deploy that silently kills both the host-based
  // preview unlock (src/lib/preview.js) and .github/workflows/lighthouse.yml,
  // which audits every PR at that hostname. wrangler warns about the
  // false+true pairing but honours it.
  "preview_urls": true,
  "observability": {
    "enabled": true
  },
  "compatibility_flags": [
    "global_fetch_strictly_public",
    "nodejs_compat"
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "dist/client"
  },

  // ── Preview environment isolation ───────────────────────────
  // Branch/PR builds deploy to a SEPARATE Worker
  // (`mjrossi-portfolio-website-preview`), never to production. This
  // is a deploy-target firewall, not just secret hygiene: because
  // branch versions no longer land on the production Worker, a secret
  // edit in the Cloudflare dashboard — which redeploys the Worker's
  // LATEST uploaded version — can only ever re-promote `main`. Before
  // this split, a mid-feature secret edit promoted branch code to
  // mjrossi.com.
  //
  // HOW THE ENV IS SELECTED — READ THIS BEFORE TOUCHING THE DEPLOY
  // COMMANDS. Under @astrojs/cloudflare v14 (Astro 6) the adapter
  // owns the wrangler config: `astro build` regenerates
  // `dist/server/wrangler.json` and STRIPS this `env` block. So
  // `wrangler deploy --env preview` at deploy time does NOTHING — the
  // env is already baked. The Cloudflare Vite plugin instead selects
  // the environment at BUILD time from the `CLOUDFLARE_ENV` variable:
  // `CLOUDFLARE_ENV=preview astro build` bakes name/ workers_dev/
  // preview_urls from `env.preview` below into the generated config,
  // and a plain `wrangler versions upload` (no --env) then ships it to
  // the preview Worker.
  //
  // Load-bearing operator config (NOT expressed here — set in the
  // Cloudflare dashboard → Workers → Settings → Build):
  //   • Build command is branch-conditional — preview only on
  //     non-`main` (WORKERS_CI_BRANCH is injected by Workers Builds):
  //       sh -c 'if [ "$WORKERS_CI_BRANCH" = "main" ]; \
  //         then npm run build; else CLOUDFLARE_ENV=preview npm run build; fi'
  //     (The Cloudflare build gets Node + the Turnstile key from the
  //      NODE_VERSION and PUBLIC_TURNSTILE_SITE_KEY build variables in
  //      the dashboard — not mise — so no mise activation is needed here.)
  //   • Production deploy command stays `npx wrangler deploy`.
  //   • Non-production deploy command is a PLAIN `npx wrangler
  //     versions upload` (NO `--env` — the build already chose the env).
  // `versions upload` (not `deploy`) preserves the per-branch preview
  // URL `<alias>-mjrossi-portfolio-website-preview.<sub>.workers.dev`,
  // which .github/workflows/lighthouse.yml audits and isPreviewHost
  // (src/lib/preview.js) unlocks. The preview Worker's secrets are set
  // separately and mirror production (its SESSION KV namespace is
  // auto-provisioned by the Workers Builds token on first deploy):
  //     wrangler secret put BUTTONDOWN_API_KEY   --env preview
  //     wrangler secret put TURNSTILE_SECRET_KEY --env preview
  //     wrangler secret put PREVIEW_SIGNING_KEY  --env preview
  //   (`secret put --env preview` DOES honor this block — only the
  //    build/deploy path is routed through the adapter-generated config.)
  //
  // `workers_dev: false` means the preview Worker has no bare
  // `mjrossi-portfolio-website-preview.<sub>.workers.dev` alias, so
  // although isPreviewHost would unlock that host if it existed, it
  // never does — the only live preview hosts are the per-branch
  // aliased URLs, which are meant to show drafts. `preview_urls: true`
  // keeps those aliased URLs on.
  "env": {
    "preview": {
      "name": "mjrossi-portfolio-website-preview",
      "workers_dev": false,
      "preview_urls": true
    }
  }
}
