{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mjrossi-portfolio-website",
  "compatibility_date": "2026-04-17",

  // Disable the Worker's own `<name>.<subdomain>.workers.dev` alias. It is on
  // by default and serves PRODUCTION on a hostname derivable from this repo,
  // which `isPreviewHost` would otherwise treat as a preview and hand every
  // scheduled draft to — RSS included. src/lib/preview.js excludes the alias
  // in code as well; this is defence in depth, not a substitute.
  "workers_dev": false,

  // Per-branch preview URLs (`<alias>-<name>.<subdomain>.workers.dev`) are a
  // SEPARATE setting, and this must stay explicit. `preview_urls` defaults to
  // false in the config schema, and when it is absent from this file wrangler
  // resolves it from server-side state at deploy time — it warns that "your
  // 'preview_urls' setting is not in your Wrangler file" and then tracks the
  // workers.dev route status, which the line above just turned off. Leaving it
  // implicit therefore risks a deploy that silently kills both the host-based
  // preview unlock (src/lib/preview.js) and .github/workflows/lighthouse.yml,
  // which audits every PR at that hostname. wrangler warns about the
  // false+true pairing but honours it.
  "preview_urls": true,
  "observability": {
    "enabled": true
  },
  "compatibility_flags": [
    "global_fetch_strictly_public",
    "nodejs_compat"
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "dist/client"
  },

  // Astro sessions. NOT a feature this site uses — no route calls
  // `Astro.session`. It is declared because @astrojs/cloudflare injects it
  // whether we ask for it or not: when `config.session.driver` is unset the
  // adapter enables the Cloudflare KV session driver unconditionally and
  // writes `kv_namespaces: [{binding: "SESSION"}]` into
  // dist/server/wrangler.json at build time. There is no clean way to turn
  // that off, so the namespace exists on the deployed Worker either way.
  //
  // Declaring it here means the resource is visible in the repo rather than
  // only in generated output and the Cloudflare dashboard — the drift this
  // line exists to close. `id` is an account-scoped identifier, not a
  // credential. scripts/smoke.mjs asserts every binding in the generated
  // config is declared here, so if a future adapter release injects another
  // one, the build fails instead of the dashboard quietly growing a binding
  // nobody wrote down.
  "kv_namespaces": [
    {
      "binding": "SESSION",
      "id": "0d4700ae1ed342579b0e0cb79cd8c4c1"
    }
  ]

  // ── Preview environment isolation (not active) ──────────────
  // Branch deploys currently share production secrets — the same
  // BUTTONDOWN_API_KEY set via `wrangler secret put` is injected
  // into both prod and PR-branch deployments. Subscriptions
  // submitted via a preview URL therefore land in the production
  // Buttondown account. For a personal portfolio this is fine
  // (preview URLs are noindex'd; volume is tiny).
  //
  // To isolate preview deploys with their own secrets:
  //   1. Add an "env" block here:
  //        "env": {
  //          "preview": { "name": "mjrossi-portfolio-website-preview" }
  //        }
  //   2. Set the preview-only secrets:
  //        wrangler secret put BUTTONDOWN_API_KEY --env preview
  //        wrangler secret put TURNSTILE_SECRET_KEY --env preview
  //      (use a separate Buttondown account or accept submissions
  //       are sandbox-only — Buttondown's free tier is generous.)
  //   3. Change Cloudflare → Workers → your project → Settings →
  //      Build configuration → Deploy command to conditionally
  //      append `--env preview` for non-main branches, e.g.:
  //        npm run build && \
  //          if [ "$CI_BRANCH" = "main" ]; \
  //            then wrangler deploy; \
  //            else wrangler deploy --env preview; \
  //          fi
  //   4. PUBLIC_TURNSTILE_SITE_KEY in Cloudflare's Build config
  //      can stay the same (the test key works on *.workers.dev),
  //      or be overridden per branch.
}
